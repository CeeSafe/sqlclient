// Request messages: SQLBatch (MS-TDS 2.2.6.7) and RPC (2.2.6.6), each after its ALL_HEADERS (2.2.5.3).

/// `sp_executesql`'s procedure id.
const PROC_EXECUTESQL: u16 = 10;
/// The most bytes a non-(MAX) nvarchar, varchar or varbinary value holds.
const SHORT_VALUE: usize = 8000;

/// ALL_HEADERS with the transaction descriptor header: the open transaction's descriptor, one outstanding request.
fn putAllHeaders(out: borrow mut Vector<u8>, descriptor: u64) -> Result<void, AllocError> {
    out.pushLE(22u32)?;
    out.pushLE(18u32)?;
    out.pushLE(0x0002u16)?;
    out.pushLE(descriptor)?;
    return out.pushLE(1u32);
}

/// A SQLBatch: the headers, then the SQL in UTF-16.
fn putSqlBatch(out: borrow mut Vector<u8>, sql: StringView, descriptor: u64) -> Result<void, AllocError> {
    out.clear();
    putAllHeaders(out, descriptor)?;
    return Utf16.encode(sql, out);
}

/// What `putParam` needs of the session: the collation text parameters carry, and its code page.
struct SessionText {
    collation: [u8; 5];
    codePage: u16;
}

/// A parameter's name as a B_VARCHAR: its UTF-16 length in one byte, then UTF-16.
fn putParamName(out: borrow mut Vector<u8>, name: Slice<u8>) -> Result<void, MsSqlError> {
    let text = StringView.fromUtf8(name) ?? "";
    let units = Utf16.encodedLength(text) / 2;
    if (units > 255) {
        return Err(MsSqlError.TooLarge);
    }
    allocated(out.push(truncate<u8>(units)))?;
    return allocated(Utf16.encode(text, out));
}

/// An unnamed nvarchar input parameter holding `text` (sp_executesql's statement and declarations).
fn putUnnamedText(out: borrow mut Vector<u8>, text: StringView, session: SessionText) -> Result<void, MsSqlError> {
    allocated(out.push(0))?; // no name
    allocated(out.push(0))?; // input
    return putTextValue(out, text, session, false);
}

/// TYPE_INFO and value of an nvarchar holding `text`: nvarchar(4000) when it fits, else nvarchar(max) as PLP.
fn putTextValue(
    out: borrow mut Vector<u8>,
    text: StringView,
    session: SessionText,
    isNull: bool,
) -> Result<void, MsSqlError> {
    let length = Utf16.encodedLength(text);
    let long = !isNull && length > SHORT_VALUE;
    allocated(out.push(0xE7))?;
    allocated(out.pushLE(if (long) 0xFFFFu16 else 8000u16))?;
    allocated(out.extend(session.collation[..]))?;
    if (isNull) {
        return allocated(out.pushLE(0xFFFFu16));
    }
    if (long) {
        allocated(out.pushLE(length as u64))?;
        if (length > 0xFFFFFFFF) {
            return Err(MsSqlError.TooLarge);
        }
        allocated(out.pushLE(truncate<u32>(length)))?;
        allocated(Utf16.encode(text, out))?;
        return allocated(out.pushLE(0u32));
    }
    allocated(out.pushLE(truncate<u16>(length)))?;
    return allocated(Utf16.encode(text, out));
}

/// A byte value of type `wire` (varchar 0xA7 with a collation, varbinary 0xA5 without): 8000 when it fits, else
/// (max) as PLP.
fn putBytesValue(
    out: borrow mut Vector<u8>,
    wire: u8,
    bytes: Slice<u8>,
    session: SessionText,
    isNull: bool,
) -> Result<void, MsSqlError> {
    let long = !isNull && bytes.length > SHORT_VALUE;
    allocated(out.push(wire))?;
    allocated(out.pushLE(if (long) 0xFFFFu16 else 8000u16))?;
    if (wire == 0xA7) {
        allocated(out.extend(session.collation[..]))?;
    }
    if (isNull) {
        return allocated(out.pushLE(0xFFFFu16));
    }
    if (long) {
        if (bytes.length > 0xFFFFFFFF) {
            return Err(MsSqlError.TooLarge);
        }
        allocated(out.pushLE(bytes.length as u64))?;
        allocated(out.pushLE(truncate<u32>(bytes.length)))?;
        allocated(out.extend(bytes))?;
        return allocated(out.pushLE(0u32));
    }
    allocated(out.pushLE(truncate<u16>(bytes.length)))?;
    return allocated(out.extend(bytes));
}

/// One parameter: name, status, TYPE_INFO, value.
fn putParam(
    out: borrow mut Vector<u8>,
    params: borrow MsSqlParams,
    p: MsParam,
    session: SessionText,
    scratch: borrow mut Vector<u8>,
) -> Result<void, MsSqlError> {
    putParamName(out, params.nameOf(p))?;
    allocated(out.push(if (p.output) 0x01u8 else 0x00u8))?;
    let v = params.valueOf(p);
    let k = p.kind;
    if (k == P_BIGINT || k == P_INT || k == P_SMALLINT || k == P_TINYINT) {
        let size: u8 = if (k == P_BIGINT) 8u8 else (if (k == P_INT) 4u8 else (if (k == P_SMALLINT) 2u8 else 1u8));
        return putFixed(out, 0x26, size, v, p.isNull);
    }
    if (k == P_BIT) {
        return putFixed(out, 0x68, 1, v, p.isNull);
    }
    if (k == P_FLOAT || k == P_REAL) {
        return putFixed(out, 0x6D, if (k == P_FLOAT) 8u8 else 4u8, v, p.isNull);
    }
    if (k == P_GUID) {
        return putFixed(out, 0x24, 16, v, p.isNull);
    }
    if (k == P_MONEY) {
        allocated(out.push(0x6E))?;
        allocated(out.push(8))?;
        if (p.isNull) {
            return allocated(out.push(0));
        }
        let units = truncate<u64>(v.readLE<i64>(0));
        allocated(out.push(8))?;
        allocated(out.pushLE(truncate<u32>(units >> 32)))?;
        return allocated(out.pushLE(truncate<u32>(units)));
    }
    if (k == P_DECIMAL) {
        allocated(out.push(0x6A))?;
        allocated(out.push(17))?;
        allocated(out.push(38))?;
        allocated(out.push(p.scale))?;
        if (p.isNull) {
            return allocated(out.push(0));
        }
        allocated(out.push(17))?;
        return allocated(out.extend(v));
    }
    if (k == P_NVARCHAR) {
        // Text was UTF-8 when it was added.
        return putTextValue(out, StringView.fromUtf8(v) ?? "", session, p.isNull);
    }
    if (k == P_VARCHAR) {
        scratch.clear();
        if (!p.isNull && !allocated2(CodePages.encode(session.codePage, v, scratch))?) {
            return Err(MsSqlError.Config); // a character the server's code page cannot hold
        }
        return putBytesValue(out, 0xA7, scratch.view(), session, p.isNull);
    }
    if (k == P_VARBINARY) {
        return putBytesValue(out, 0xA5, v, session, p.isNull);
    }
    if (k == P_DATE || k == P_TIME || k == P_DATETIME2 || k == P_DATETIMEOFFSET || k == P_DATETIME ||
        k == P_SMALLDATETIME) {
        allocated(putTemporalTypeInfo(out, k, p.scale))?;
        return putTemporalValue(out, k, v, p.isNull, p.scale);
    }
    if (k == P_XML) {
        // XML: no schema collection, the text as UTF-16 PLP.
        allocated(out.push(0xF1))?;
        allocated(out.push(0))?;
        if (p.isNull) {
            return allocated(out.pushLE(0xFFFFFFFFFFFFFFFFu64));
        }
        scratch.clear();
        allocated(Utf16.encode(StringView.fromUtf8(v) ?? "", scratch))?;
        allocated(out.pushLE(scratch.length as u64))?;
        if (scratch.length > 0) {
            allocated(out.pushLE(truncate<u32>(scratch.length)))?;
            allocated(out.extend(scratch.view()))?;
        }
        return allocated(out.pushLE(0u32));
    }
    if (k == P_TABLE) {
        return putTableValue(out, params, p, session, scratch);
    }
    return Err(MsSqlError.Config);
}

/// The TYPE_INFO of a date or time kind: `date`, `time(s)`, `datetime2(s)`, `datetimeoffset(s)`, `datetime`,
/// `smalldatetime`.
fn putTemporalTypeInfo(out: borrow mut Vector<u8>, k: u8, scale: u8) -> Result<void, AllocError> {
    if (k == P_DATE) {
        return out.push(0x28);
    }
    if (k == P_DATETIME || k == P_SMALLDATETIME) {
        out.push(0x6F)?;
        return out.push(if (k == P_DATETIME) 8u8 else 4u8);
    }
    out.push(if (k == P_TIME) 0x29u8 else (if (k == P_DATETIME2) 0x2Au8 else 0x2Bu8))?;
    return out.push(scale);
}

/// The bytes of a time of scale `scale`: 3 up to 2, 4 up to 4, else 5.
fn timeBytes(scale: u8) -> usize => if (scale <= 2) 3usize else (if (scale <= 4) 4usize else 5usize);

/// `ticks` (100 ns units) in units of scale `scale` (10^-scale seconds), the finer digits dropped.
fn scaledTicks(ticks: u64, scale: u8) -> u64 {
    var t = ticks;
    var s = scale;
    while (s < 7) {
        t = t / 10;
        s += 1;
    }
    return t;
}

/// A date or time value of kind `k` and scale `scale`, from dateParts: days (4), 100 ns units (8), offset minutes
/// (2).
fn putTemporalValue(
    out: borrow mut Vector<u8>,
    k: u8,
    v: Slice<u8>,
    isNull: bool,
    scale: u8,
) -> Result<void, MsSqlError> {
    if (isNull) {
        return allocated(out.push(0));
    }
    let days = v.readLE<u32>(0) as u64;
    let ticks = v.readLE<u64>(4);
    let offset = v.readLE<i16>(12) as i64;
    let tb = timeBytes(scale);
    if (k == P_DATE) {
        allocated(out.push(3))?;
        return putLittle(out, days, 3);
    }
    if (k == P_TIME) {
        allocated(out.push(truncate<u8>(tb)))?;
        return putLittle(out, scaledTicks(ticks, scale), tb);
    }
    if (k == P_DATETIME2) {
        allocated(out.push(truncate<u8>(tb + 3)))?;
        putLittle(out, scaledTicks(ticks, scale), tb)?;
        return putLittle(out, days, 3);
    }
    if (k == P_DATETIMEOFFSET) {
        // The wire holds UTC: local time minus the offset.
        let perDay: i64 = 864000000000;
        var utc = truncate<i64>(ticks) - offset * 600000000;
        var day = truncate<i64>(days);
        if (utc < 0) {
            utc += perDay;
            day -= 1;
        } else if (utc >= perDay) {
            utc -= perDay;
            day += 1;
        }
        if (day < 0) {
            return Err(MsSqlError.Config);
        }
        allocated(out.push(truncate<u8>(tb + 5)))?;
        putLittle(out, scaledTicks(truncate<u64>(utc), scale), tb)?;
        putLittle(out, truncate<u64>(day), 3)?;
        return allocated(out.pushLE(truncate<i16>(offset)));
    }
    if (k == P_SMALLDATETIME) {
        // Days since 1900, then minutes, rounded to the nearest (29.999 seconds and up rounds up).
        var day = truncate<i64>(days) - DAYS_0001_TO_1900;
        var minutes = (ticks + 299990000) / 600000000;
        if (minutes >= 1440) {
            minutes -= 1440;
            day += 1;
        }
        if (day < 0 || day > 65535) {
            return Err(MsSqlError.Config);
        }
        allocated(out.push(4))?;
        allocated(out.pushLE(truncate<u16>(day)))?;
        return allocated(out.pushLE(truncate<u16>(minutes)));
    }
    // datetime: days since 1900, then 1/300 seconds, rounded to the nearest.
    var day = truncate<i64>(days) - DAYS_0001_TO_1900;
    var t300 = (ticks * 3 + 50000) / 100000;
    if (t300 >= 25920000) {
        t300 -= 25920000;
        day += 1;
    }
    allocated(out.push(8))?;
    allocated(out.pushLE(truncate<i32>(day)))?;
    return allocated(out.pushLE(truncate<u32>(t300)));
}

fn allocated2(outcome: Result<bool, AllocError>) -> Result<bool, MsSqlError> {
    match (outcome) {
        Ok(b) => { return Ok(b); }
        Err(_) => { return Err(MsSqlError.OutOfMemory); }
    }
}

/// A BYTELEN type of maximum length `size`, and its value (`size` bytes, or 0 for NULL).
fn putFixed(
    out: borrow mut Vector<u8>,
    wire: u8,
    size: u8,
    value: Slice<u8>,
    isNull: bool,
) -> Result<void, MsSqlError> {
    allocated(out.push(wire))?;
    allocated(out.push(size))?;
    if (isNull) {
        return allocated(out.push(0));
    }
    allocated(out.push(size))?;
    return allocated(out.extend(value[0..size as usize]));
}

/// The low `count` bytes of `v`, little-endian.
fn putLittle(out: borrow mut Vector<u8>, v: u64, count: usize) -> Result<void, MsSqlError> {
    for (k in 0..count) {
        allocated(out.push(truncate<u8>(v >> truncate<u64>(k * 8))))?;
    }
    return Ok();
}

/// The parameters' declarations for sp_executesql: `@p1 bigint,@id nvarchar(4000) output`.
fn appendDeclarations(params: borrow MsSqlParams, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    var first = true;
    for (p in params.entryList()) {
        if (!first) {
            out.push(',')?;
        }
        first = false;
        out.extend(params.nameOf(p))?;
        out.push(' ')?;
        let v = params.valueOf(p);
        let k = p.kind;
        if (k == P_BIGINT) {
            out.extend("bigint".bytes())?;
        } else if (k == P_INT) {
            out.extend("int".bytes())?;
        } else if (k == P_SMALLINT) {
            out.extend("smallint".bytes())?;
        } else if (k == P_TINYINT) {
            out.extend("tinyint".bytes())?;
        } else if (k == P_BIT) {
            out.extend("bit".bytes())?;
        } else if (k == P_FLOAT) {
            out.extend("float".bytes())?;
        } else if (k == P_REAL) {
            out.extend("real".bytes())?;
        } else if (k == P_MONEY) {
            out.extend("money".bytes())?;
        } else if (k == P_DECIMAL) {
            out.extend("decimal(38,".bytes())?;
            pad(out, p.scale as i64, 1)?;
            out.push(')')?;
        } else if (k == P_NVARCHAR) {
            let long = Utf16.encodedLength(StringView.fromUtf8(v) ?? "") > SHORT_VALUE;
            out.extend(if (long) "nvarchar(max)".bytes() else "nvarchar(4000)".bytes())?;
        } else if (k == P_VARCHAR) {
            out.extend(if (v.length > SHORT_VALUE) "varchar(max)".bytes() else "varchar(8000)".bytes())?;
        } else if (k == P_VARBINARY) {
            out.extend(if (v.length > SHORT_VALUE) "varbinary(max)".bytes() else "varbinary(8000)".bytes())?;
        } else if (k == P_GUID) {
            out.extend("uniqueidentifier".bytes())?;
        } else if (k == P_DATE) {
            out.extend("date".bytes())?;
        } else if (k == P_TIME || k == P_DATETIME2 || k == P_DATETIMEOFFSET) {
            out.extend(
                if (k == P_TIME) "time(".bytes()
                    else (if (k == P_DATETIME2) "datetime2(".bytes() else "datetimeoffset(".bytes()),
            )?;
            pad(out, p.scale as i64, 1)?;
            out.push(')')?;
        } else if (k == P_DATETIME) {
            out.extend("datetime".bytes())?;
        } else if (k == P_SMALLDATETIME) {
            out.extend("smalldatetime".bytes())?;
        } else if (k == P_XML) {
            out.extend("xml".bytes())?;
        } else if (k == P_TABLE) {
            out.extend(v[8..])?; // the quoted type name
            out.extend(" READONLY".bytes())?;
        }
        if (p.output) {
            out.extend(" output".bytes())?;
        }
    }
    return Ok();
}

/// An RPC calling sp_executesql with `sql` and `params`.
fn putExecuteSql(
    out: borrow mut Vector<u8>,
    sql: StringView,
    params: borrow MsSqlParams,
    descriptor: u64,
    session: SessionText,
) -> Result<void, MsSqlError> {
    out.clear();
    allocated(putAllHeaders(out, descriptor))?;
    return putExecuteSqlCall(out, sql, params, session, true);
}

/// The body of an RPC calling sp_executesql (after ALL_HEADERS): the statement, and the declarations and values
/// when there are parameters or `declareAlways`.
fn putExecuteSqlCall(
    out: borrow mut Vector<u8>,
    sql: StringView,
    params: borrow MsSqlParams,
    session: SessionText,
    declareAlways: bool,
) -> Result<void, MsSqlError> {
    allocated(out.pushLE(0xFFFFu16))?; // a procedure by id
    allocated(out.pushLE(PROC_EXECUTESQL))?;
    allocated(out.pushLE(0u16))?; // option flags
    putUnnamedText(out, sql, session)?;
    if (params.count() == 0 && !declareAlways) {
        return Ok();
    }
    var declarations = Vector<u8>.create();
    allocated(appendDeclarations(params, mut declarations))?;
    putUnnamedText(out, StringView.fromUtf8(declarations.view()) ?? "", session)?;
    var scratch = Vector<u8>.create();
    for (p in params.entryList()) {
        putParam(out, params, p, session, mut scratch)?;
    }
    return Ok();
}

/// An RPC calling stored procedure `name` (`dbo.GetOrders`, `[my proc]`) with `params` by name.
fn putProcedureCall(
    out: borrow mut Vector<u8>,
    name: StringView,
    params: borrow MsSqlParams,
    descriptor: u64,
    session: SessionText,
) -> Result<void, MsSqlError> {
    out.clear();
    allocated(putAllHeaders(out, descriptor))?;
    return putProcedureBody(out, name, params, session);
}

/// The body of an RPC calling stored procedure `name` (after ALL_HEADERS).
fn putProcedureBody(
    out: borrow mut Vector<u8>,
    name: StringView,
    params: borrow MsSqlParams,
    session: SessionText,
) -> Result<void, MsSqlError> {
    let units = Utf16.encodedLength(name) / 2;
    if (units == 0 || units > 0xFFFE) {
        return Err(MsSqlError.Config);
    }
    allocated(out.pushLE(truncate<u16>(units)))?;
    allocated(Utf16.encode(name, out))?;
    allocated(out.pushLE(0u16))?; // option flags
    var scratch = Vector<u8>.create();
    for (p in params.entryList()) {
        putParam(out, params, p, session, mut scratch)?;
    }
    return Ok();
}

/// One RPC message holding every command of `batch`, separated by BatchFlag (MS-TDS 2.2.6.6, TDS 7.2+).
fn putBatch(
    out: borrow mut Vector<u8>,
    batch: borrow MsSqlBatch,
    descriptor: u64,
    session: SessionText,
) -> Result<void, MsSqlError> {
    out.clear();
    allocated(putAllHeaders(out, descriptor))?;
    var first = true;
    for (command in batch.commandList()) {
        if (!first) {
            allocated(out.push(0xFF))?;
        }
        first = false;
        if (command.procedure) {
            putProcedureBody(out, command.text.view(), borrow command.params, session)?;
        } else {
            putExecuteSqlCall(out, command.text.view(), borrow command.params, session, false)?;
        }
    }
    return Ok();
}

// ---- Rows: table-valued parameters (MS-TDS 2.2.5.5.5) and bulk loads (2.2.6.1) ----

/// The packet type of a bulk load's rows.
const PKT_BULK_LOAD: u8 = 0x07;

/// The TYPE_INFO of column `c`.
fn putColumnTypeInfo(out: borrow mut Vector<u8>, c: MsTableColumn, session: SessionText) -> Result<void, AllocError> {
    let k = c.kind;
    if (k == P_BIGINT || k == P_INT || k == P_SMALLINT || k == P_TINYINT) {
        out.push(0x26)?;
        return out.push(if (k == P_BIGINT) 8u8 else (if (k == P_INT) 4u8 else (if (k == P_SMALLINT) 2u8 else 1u8)));
    }
    if (k == P_BIT) {
        out.push(0x68)?;
        return out.push(1);
    }
    if (k == P_FLOAT || k == P_REAL) {
        out.push(0x6D)?;
        return out.push(if (k == P_FLOAT) 8u8 else 4u8);
    }
    if (k == P_GUID) {
        out.push(0x24)?;
        return out.push(16);
    }
    if (k == P_MONEY) {
        out.push(0x6E)?;
        return out.push(8);
    }
    if (k == P_DECIMAL) {
        out.push(0x6A)?;
        out.push(decimalSize(c.precision))?;
        out.push(c.precision)?;
        return out.push(c.scale);
    }
    if (k == P_NVARCHAR || k == P_VARCHAR || k == P_VARBINARY) {
        out.push(if (k == P_NVARCHAR) 0xE7u8 else (if (k == P_VARCHAR) 0xA7u8 else 0xA5u8))?;
        let bytes = if (k == P_NVARCHAR) c.length * 2 else c.length;
        out.pushLE(if (c.length == 0) 0xFFFFu16 else truncate<u16>(bytes))?;
        if (k != P_VARBINARY) {
            out.extend(session.collation[..])?;
        }
        return Ok();
    }
    return putTemporalTypeInfo(out, k, c.scale);
}

/// The fixed-length type of a kind that has one (INT1/2/4/8, BIT, FLT4/8, MONEY, DATETIME), else 0.
fn fixedType(k: u8) -> u8 {
    if (k == P_TINYINT) {
        return 0x30;
    }
    if (k == P_SMALLINT) {
        return 0x34;
    }
    if (k == P_INT) {
        return 0x38;
    }
    if (k == P_BIGINT) {
        return 0x7F;
    }
    if (k == P_BIT) {
        return 0x32;
    }
    if (k == P_REAL) {
        return 0x3B;
    }
    if (k == P_FLOAT) {
        return 0x3E;
    }
    if (k == P_MONEY) {
        return 0x3C;
    }
    if (k == P_DATETIME) {
        return 0x3D;
    }
    return 0;
}

/// The bytes a `decimal(precision, s)` value takes on the wire: its sign, then 4, 8, 12 or 16 bytes.
fn decimalSize(precision: u8) -> u8 =>
    if (precision <= 9) 5u8 else (if (precision <= 19) 9u8 else (if (precision <= 28) 13u8 else 17u8));

/// A value `v` (as `MsSqlParams` keeps it) in column `c`.
fn putColumnValue(
    out: borrow mut Vector<u8>,
    c: MsTableColumn,
    v: Slice<u8>,
    isNull: bool,
    session: SessionText,
    scratch: borrow mut Vector<u8>,
) -> Result<void, MsSqlError> {
    let k = c.kind;
    if (k == P_BIGINT || k == P_INT || k == P_SMALLINT || k == P_TINYINT || k == P_BIT || k == P_FLOAT ||
        k == P_REAL || k == P_GUID) {
        if (isNull) {
            return allocated(out.push(0));
        }
        allocated(out.push(truncate<u8>(v.length)))?;
        return allocated(out.extend(v));
    }
    if (k == P_MONEY) {
        if (isNull) {
            return allocated(out.push(0));
        }
        let units = truncate<u64>(v.readLE<i64>(0));
        allocated(out.push(8))?;
        allocated(out.pushLE(truncate<u32>(units >> 32)))?;
        return allocated(out.pushLE(truncate<u32>(units)));
    }
    if (k == P_DECIMAL) {
        if (isNull) {
            return allocated(out.push(0));
        }
        let size = decimalSize(c.precision) as usize;
        allocated(out.push(truncate<u8>(size)))?;
        return allocated(out.extend(v[0..size])); // the sign, then the magnitude's low bytes
    }
    if (k == P_NVARCHAR || k == P_VARCHAR || k == P_VARBINARY) {
        var bytes = v;
        if (k == P_NVARCHAR) {
            scratch.clear();
            if (!isNull) {
                allocated(Utf16.encode(StringView.fromUtf8(v) ?? "", scratch))?;
            }
            bytes = scratch.view();
        } else if (k == P_VARCHAR) {
            scratch.clear();
            if (!isNull && !allocated2(CodePages.encode(session.codePage, v, scratch))?) {
                return Err(MsSqlError.Config); // a character the server's code page cannot hold
            }
            bytes = scratch.view();
        }
        if (c.length == 0) {
            // (max): PLP chunks, NULL as all ones.
            if (isNull) {
                return allocated(out.pushLE(0xFFFFFFFFFFFFFFFFu64));
            }
            if (bytes.length > 0x7FFFFFFF) {
                return Err(MsSqlError.TooLarge);
            }
            // PLP_UNKNOWN_LEN, as SqlClient sends: SQL Server's bulk load reads a PLP value with a known total
            // length as if more followed ("premature end-of-message"), so rows always give an unknown one.
            allocated(out.pushLE(0xFFFFFFFFFFFFFFFEu64))?;
            if (bytes.length > 0) {
                allocated(out.pushLE(truncate<u32>(bytes.length)))?;
                allocated(out.extend(bytes))?;
            }
            return allocated(out.pushLE(0u32));
        }
        if (isNull) {
            return allocated(out.pushLE(0xFFFFu16));
        }
        let limit = if (k == P_NVARCHAR) c.length as usize * 2 else c.length as usize;
        if (bytes.length > limit) {
            return Err(MsSqlError.TooLarge);
        }
        allocated(out.pushLE(truncate<u16>(bytes.length)))?;
        return allocated(out.extend(bytes));
    }
    return putTemporalValue(out, k, v, isNull, c.scale);
}

/// Every row of `table`, each after `rowToken`, its values in column order.
fn putRows(
    out: borrow mut Vector<u8>,
    table: borrow MsSqlTable,
    rowToken: u8,
    session: SessionText,
    scratch: borrow mut Vector<u8>,
) -> Result<void, MsSqlError> {
    let columns = table.columnList();
    let cells = table.cellList();
    var i: usize = 0;
    for (cell in cells.entryList()) {
        if (i == 0) {
            allocated(out.push(rowToken))?;
        }
        putColumnValue(out, columns[i], cells.valueOf(cell), cell.isNull, session, scratch)?;
        i += 1;
        if (i == columns.length) {
            i = 0;
        }
    }
    return Ok();
}

/// A B_VARCHAR: a count of UTF-16 code units in one byte, then UTF-16.
fn putBVarchar(out: borrow mut Vector<u8>, text: Slice<u8>) -> Result<void, MsSqlError> => putParamName(out, text);

/// A table-valued parameter's TYPE_INFO and rows (after its name and status).
fn putTableValue(
    out: borrow mut Vector<u8>,
    params: borrow MsSqlParams,
    p: MsParam,
    session: SessionText,
    scratch: borrow mut Vector<u8>,
) -> Result<void, MsSqlError> {
    let table = params.tableOf(p);
    let quoted = params.valueOf(p)[8..]; // `[schema].[name]` or `[name]`
    allocated(out.push(0xF3))?;
    // TVP_TYPENAME: no database, then the schema (or none) and the name, without their brackets.
    allocated(out.push(0))?;
    let text = StringView.fromUtf8(quoted) ?? "";
    match (text.indexOf("].[")) {
        Some(dot) => {
            putBVarchar(out, quoted[1..dot])?;
            putBVarchar(out, quoted[dot + 3..quoted.length - 1])?;
        }
        null => {
            allocated(out.push(0))?;
            putBVarchar(out, quoted[1..quoted.length - 1])?;
        }
    }
    // TVP_COLMETADATA: each column nullable and nameless, as the type names them.
    let columns = table.columnList();
    allocated(out.pushLE(truncate<u16>(columns.length)))?;
    for (c in columns) {
        allocated(out.pushLE(0u32))?;      // user type
        allocated(out.pushLE(0x0001u16))?; // nullable
        allocated(putColumnTypeInfo(out, c, session))?;
        allocated(out.push(0))?; // no name
    }
    allocated(out.push(0x00))?;                   // TVP_END_TOKEN: no ordering
    putRows(out, table, 0x01, session, scratch)?; // TVP_ROW_TOKEN
    return allocated(out.push(0x00));             // TVP_END_TOKEN
}

/// `column type` for each of `table`'s columns, in parentheses, as INSERT BULK declares them.
fn appendBulkColumns(table: borrow MsSqlTable, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    out.extend(" (".bytes())?;
    var first = true;
    for (c in table.columnList()) {
        if (!first) {
            out.extend(", ".bytes())?;
        }
        first = false;
        out.push('[')?;
        out.extend(table.columnName(c).bytes())?;
        out.extend("] ".bytes())?;
        let k = c.kind;
        if (k == P_BIGINT) {
            out.extend("bigint".bytes())?;
        } else if (k == P_INT) {
            out.extend("int".bytes())?;
        } else if (k == P_SMALLINT) {
            out.extend("smallint".bytes())?;
        } else if (k == P_TINYINT) {
            out.extend("tinyint".bytes())?;
        } else if (k == P_BIT) {
            out.extend("bit".bytes())?;
        } else if (k == P_FLOAT) {
            out.extend("float".bytes())?;
        } else if (k == P_REAL) {
            out.extend("real".bytes())?;
        } else if (k == P_MONEY) {
            out.extend("money".bytes())?;
        } else if (k == P_GUID) {
            out.extend("uniqueidentifier".bytes())?;
        } else if (k == P_DECIMAL) {
            out.extend("decimal(".bytes())?;
            pad(out, c.precision as i64, 1)?;
            out.push(',')?;
            pad(out, c.scale as i64, 1)?;
            out.push(')')?;
        } else if (k == P_NVARCHAR || k == P_VARCHAR || k == P_VARBINARY) {
            out.extend(
                if (k == P_NVARCHAR) "nvarchar(".bytes()
                    else (if (k == P_VARCHAR) "varchar(".bytes() else "varbinary(".bytes()),
            )?;
            if (c.length == 0) {
                out.extend("max".bytes())?;
            } else {
                pad(out, c.length as i64, 1)?;
            }
            out.push(')')?;
        } else if (k == P_DATE) {
            out.extend("date".bytes())?;
        } else if (k == P_TIME) {
            out.extend("time(7)".bytes())?;
        } else if (k == P_DATETIME2) {
            out.extend("datetime2(7)".bytes())?;
        } else if (k == P_DATETIMEOFFSET) {
            out.extend("datetimeoffset(7)".bytes())?;
        } else if (k == P_DATETIME) {
            out.extend("datetime".bytes())?;
        }
    }
    return out.push(')');
}

/// A bulk load's message: COLMETADATA naming the columns, a ROW per row, then DONE.
/// `nullable` says, column by column, whether the target column takes NULL: SQL Server wants a NOT NULL column's
/// value in its fixed-length type (INT4, not INTN), as the target's own metadata has it.
fn putBulkLoad(
    out: borrow mut Vector<u8>,
    table: borrow MsSqlTable,
    nullable: Slice<bool>,
    session: SessionText,
) -> Result<void, MsSqlError> {
    out.clear();
    let columns = table.columnList();
    allocated(out.push(0x81))?;
    allocated(out.pushLE(truncate<u16>(columns.length)))?;
    for (i in 0..columns.length) {
        let c = columns[i];
        allocated(out.pushLE(0u32))?;                                      // user type
        allocated(out.pushLE(if (nullable[i]) 0x0005u16 else 0x0004u16))?; // read/write, and nullable or not
        let fixed = if (nullable[i]) 0u8 else fixedType(c.kind);
        if (fixed != 0) {
            allocated(out.push(fixed))?;
        } else {
            allocated(putColumnTypeInfo(out, c, session))?;
        }
        putBVarchar(out, table.columnName(c).bytes())?;
    }
    var scratch = Vector<u8>.create();
    var value = Vector<u8>.create();
    let cells = table.cellList();
    var i: usize = 0;
    for (cell in cells.entryList()) {
        if (i == 0) {
            allocated(out.push(0xD1))?; // ROW
        }
        let fixed = if (nullable[i]) 0u8 else fixedType(columns[i].kind);
        if (fixed != 0) {
            if (cell.isNull) {
                return Err(MsSqlError.Config); // NULL for a NOT NULL column
            }
            // The value without its length: everything after the BYTELEN putColumnValue writes.
            value.clear();
            putColumnValue(mut value, columns[i], cells.valueOf(cell), false, session, mut scratch)?;
            allocated(out.extend(value[1..]))?;
        } else {
            putColumnValue(out, columns[i], cells.valueOf(cell), cell.isNull, session, mut scratch)?;
        }
        i += 1;
        if (i == columns.length) {
            i = 0;
        }
    }
    allocated(out.push(0xFD))?; // DONE: final, no count
    allocated(out.pushLE(0u16))?;
    allocated(out.pushLE(0u16))?;
    return allocated(out.pushLE(0u64));
}
