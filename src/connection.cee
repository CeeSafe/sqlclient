import tls.TlsConfig;
import tls.TlsEngine;
import tls.TlsError;

// Packet types (MS-TDS 2.2.3.1.1).
const PKT_SQL_BATCH: u8 = 0x01;
const PKT_RPC: u8 = 0x03;
const PKT_ATTENTION: u8 = 0x06;
const PKT_LOGIN7: u8 = 0x10;
const PKT_SSPI: u8 = 0x11;
const PKT_PRELOGIN: u8 = 0x12;

// Packet status bits.
const STATUS_EOM: u8 = 0x01;
const STATUS_RESET_CONNECTION: u8 = 0x08;

// DONE status bits (2.2.7.6).
const DONE_MORE: u16 = 0x0001;
const DONE_COUNT: u16 = 0x0010;
const DONE_ATTN: u16 = 0x0020;
/// DONE's CurCmd for a SELECT.
const CMD_SELECT: u16 = 0xC1;

/// Packets of at most this size until the server agrees on another (the login itself is sent so).
const LOGIN_PACKET_SIZE: usize = 4096;
/// How much is read from the socket at a time, and the input buffer's starting size.
const READ_CHUNK: usize = 32 * 1024;
/// Packets are gathered up to this size before a write.
const WRITE_BATCH: usize = 64 * 1024;
/// How long recovering from a timeout (the attention and its answer) may take.
const ATTENTION_TIMEOUT_MS: u64 = 5000;
/// At most this many INFO messages are kept per operation (a loop of PRINTs must not exhaust memory).
const MAX_INFOS: usize = 1000;
const MAX_ERRORS: usize = 100;

// What `step` stops for.
const EV_COLUMNS: u8 = 1;
const EV_ROW: u8 = 2;
const EV_DONE: u8 = 3;
const EV_END: u8 = 4;
/// `parseToken`: the token runs past the bytes received (`needBytes` from the token's start).
const NEED: u8 = 255;

// A streamed query's state.
const S_IDLE: u8 = 0;
/// In a result: `fetch` gives its rows.
const S_ROWS: u8 = 1;
/// A result has ended; whether another follows is not known yet.
const S_BETWEEN: u8 = 2;
/// The next result's columns have been read; `nextResult` enters it.
const S_NEXT: u8 = 3;

// What `perform` does, under the command timeout.
const OP_COLLECT: u8 = 1;
const OP_START: u8 = 2;
const OP_FETCH: u8 = 3;
const OP_NEXT: u8 = 4;
const OP_FINISH: u8 = 5;

// Which results `collect` keeps.
const KEEP_NONE: u8 = 0;
const KEEP_FIRST: u8 = 1;
const KEEP_ALL: u8 = 2;

/// A DONE, DONEPROC or DONEINPROC token.
struct DoneInfo {
    token: u8;
    status: u16;
    command: u16;
    count: u64;
}

/// The server's version, from its LOGINACK: 16 is SQL Server 2022, 15 2019, 14 2017.
public struct MsServerVersion {
    public major: u8;
    public minor: u8;
    public build: u16;
}

/// A transaction's isolation level.
public enum MsIsolation {
    ReadUncommitted,
    ReadCommitted,
    RepeatableRead,
    Serializable,
    Snapshot,
}

/// Every result of a batch or a stored procedure call: its result sets, output parameters and return status.
@noncopy
public struct MsSqlResults {
    private sets: Vector<MsSqlRows>;
    private out: MsSqlRows;
    private status: i32?;
    private affected: u64;

    /// No results yet.
    public fn create() -> MsSqlResults => MsSqlResults {
        sets: Vector<MsSqlRows>.create(),
        out: MsSqlRows.create(),
        status: null,
        affected: 0,
    };

    /// How many result sets came back.
    public fn count(borrow this) -> usize => this.sets.length;

    /// Result set `i` (from 0); panics when there is none.
    public fn result(borrow this, i: usize) -> borrow MsSqlRows => borrow this.sets[i];

    /// The output parameters as one row, a column per parameter, named without its `@`:
    /// `outputs().int64(0, outputs().columnIndex("total")!)`.
    public fn outputs(borrow this) -> borrow MsSqlRows => borrow this.out;

    /// A stored procedure's `RETURN` value, or null.
    public fn returnStatus(borrow this) -> i32? => this.status;

    /// The rows the batch's INSERT, UPDATE, DELETE and MERGE statements affected, in all.
    public fn affectedRows(borrow this) -> u64 => this.affected;
}

/// One session with SQL Server over TDS 7.4 (or TDS 8.0 with `Encrypt=strict`).
///
/// - **Queries.** `query` gives the first result set's rows, `queryAll` every result set, `execute` the count of
///   rows changed; `callProcedure` calls a stored procedure with output parameters and its return status. With
///   parameters a statement runs through `sp_executesql`, its values typed and apart from the SQL; without, as a
///   plain batch (so a script with `GO`-free batches of DDL works, and a temporary table it makes stays for later
///   statements).
/// - **Streaming.** `start`, then `fetch` up to n rows at a time, `nextResult` to move on, `finish` (or `cancel`)
///   at the end: for results too large to hold at once.
/// - **Errors.** A failed statement gives `MsSqlError.Server`; `errors()` has every message the server sent,
///   `lastError()` the first, and the connection is usable again. `PRINT` and other informational messages are in
///   `messages()`. Both are cleared when the next operation starts.
/// - **Timeouts.** Every operation is bounded by the command timeout (30 s by default, `Command Timeout`). When it
///   runs out the server is told to stop (an attention) and its answer drained, so the connection stays usable and
///   the operation fails with `TimedOut`.
/// - **One operation at a time.** Every operation takes `borrow mut this`. If one is cancelled from outside, or
///   fails partway, the connection reports `Broken` from then on: drop it, or try `recover()`.
@noncopy
public struct MsSqlConnection {
    private tcp: AsyncTcpStream;
    private tls: TlsEngine?;
    /// Raw bytes from the socket, before decryption.
    private net: Vector<u8>;
    /// Ciphertext to send.
    private cipher: Vector<u8>;
    /// The stream after TLS: `[inStart, inEnd)` is not yet taken apart into packets.
    private input: Vector<u8>;
    private inStart: usize;
    private inEnd: usize;
    /// The current message's packet payloads, joined: tokens from `payStart` on are not read yet.
    private payload: Vector<u8>;
    private payStart: usize;
    /// The packet with the end-of-message bit has arrived.
    private messageDone: bool;
    /// The response's final DONE has been read.
    private ended: bool;
    private needBytes: usize;
    /// The message being built, without packet headers.
    private output: Vector<u8>;
    /// Packets being sent.
    private wire: Vector<u8>;
    private packetSize: usize;
    /// An exchange has started and its response is not finished.
    private busy: bool;
    /// A request is being written: a timeout now leaves half a packet on the wire.
    private sending: bool;
    private stream: u8;
    /// The open transaction's descriptor, or 0.
    private descriptor: u64;
    private session: SessionText;
    private meta: MsMeta;
    private lastDone: DoneInfo;
    private errorList: Vector<MsSqlMessage>;
    private infoList: Vector<MsSqlMessage>;
    private status: i32?;
    /// Streaming one value of a row (`nextRow`): 0 none, 1 reading the value, 2 the value read and the rest of the
    /// row not yet.
    /// The session's language (ENVCHANGE), for session recovery.
    private languageName: String;
    /// What session recovery needs, and whether this login is a reconnect.
    private recovery: MsSessionRecovery;
    private reconnecting: bool;
    /// How many times the session was recovered.
    private recoveredCount: u32;
    private seqPhase: u8;
    /// The streamed column.
    private seqColumn: usize;
    /// What is left of the current PLP chunk.
    private seqChunkLeft: usize;
    /// The row's NBCROW null bitmap, or empty.
    private seqBitmap: Vector<u8>;
    /// Bytes of a character split between chunks, for `readText`.
    private seqPending: Vector<u8>;
    private outputs: MsSqlRows;
    /// A small token's body, copied out of the payload to be handled.
    private tokenBody: Vector<u8>;
    private loginAcked: bool;
    private sspi: Vector<u8>;
    private version: MsServerVersion;
    private databaseName: String;
    private routeHost: String;
    private routePort: u16;
    private resetPending: bool;
    private commandMillis: u64;
    private spid: u16;
    /// An error of severity 20 or more: the server ends the session.
    private fatal: bool;
    private streamCount: u64;

    // ---- Connecting ----

    /// Connects, agrees on encryption, and logs in, within the connect timeout. A host's addresses are tried in
    /// order, or all at once with `MultiSubnetFailover`. A named instance without a port is looked up through SQL
    /// Server Browser; a redirect from the server (Azure SQL's gateway) is followed once. A transient login error
    /// (an Azure SQL database starting, paused or moving: 4060, 40613, …) is tried again up to `ConnectRetryCount`
    /// times, `ConnectRetryInterval` apart, each attempt with the whole connect timeout.
    public async fn connect(config: borrow MsSqlConfig) -> Result<MsSqlConnection, MsSqlError> {
        // With ConnectRetryCount, the login asks for session recovery, and the connection keeps a copy of `config`
        // to log in again with should the server drop it while it is idle.
        var features = Vector<u8>.create();
        if (config.connectRetryCount() > 0) {
            MsSessionRecovery.request(mut features)?;
        }
        var c = await MsSqlConnection.connectWith(config, features.view(), false)?;
        if (c.recovery.acknowledged) {
            c.recovery.begin(c.databaseName.view(), c.languageName.view(), c.session.collation)?;
            c.recovery.config = Some(config.clone()?);
        }
        return Ok(c);
    }

    /// `connect`, with `features` in the login (a reconnect's recovery data when `reconnecting`).
    async fn connectWith(
        config: borrow MsSqlConfig,
        features: Slice<u8>,
        reconnecting: bool,
    ) -> Result<MsSqlConnection, MsSqlError> {
        var pin = Vector<u8>.create();
        await config.loadPin(mut pin)?;
        var attempt: u8 = 0;
        loop {
            var transient = false;
            let ms = config.connectTimeout();
            let plan = MsLoginPlan { pin: pin.view(), features: features, reconnecting: reconnecting };
            let outcome = if (ms == 0) await MsSqlConnection.open(config, plan, mut transient)
                else await Async.timeout(
                    ms,
                    MsSqlError.TimedOut,
                    async () => await MsSqlConnection.open(config, plan, mut transient),
                );
            match (outcome) {
                Ok(c) => { return Ok(c); }
                Err(e) => {
                    if (!transient || attempt >= config.connectRetryCount()) {
                        return Err(e);
                    }
                }
            }
            attempt += 1;
            ioResult(await Timer.sleep(config.connectRetryInterval()))?;
        }
    }

    async fn open(
        config: borrow MsSqlConfig,
        plan: MsLoginPlan,
        transient: borrow mut bool,
    ) -> Result<MsSqlConnection, MsSqlError> {
        var port = config.port();
        if (port == 0) {
            port = await browseInstancePort(config.host(), config.instance())?;
        }
        var connection = await MsSqlConnection.openAt(config, config.host(), port, plan, transient)?;
        if (connection.routeHost.length == 0) {
            return Ok(connection);
        }
        // Routed: log in again where the server says.
        let host = replace(mut connection.routeHost, String.create());
        let routedPort = connection.routePort;
        var routed = await MsSqlConnection.openAt(config, host.view(), routedPort, plan, transient)?;
        routed.routeHost.clear();
        return Ok(routed);
    }

    async fn openAt(
        config: borrow MsSqlConfig,
        host: StringView,
        port: u16,
        plan: MsLoginPlan,
        transient: borrow mut bool,
    ) -> Result<MsSqlConnection, MsSqlError> {
        let resolved = match (await AsyncDns.resolve(host, port)) {
            Ok(a) => a,
            Err(e) => { return Err(MsSqlError.Io(e)); }
        };
        let addresses = preferred(resolved.view(), config.addressPreference())?;
        let tcp = if (config.multiSubnetFailover() && addresses.length > 1) await connectAny(addresses.view())?
            else await connectFirst(addresses.view())?;
        match (tcp.setNoDelay(true)) {
            Ok() => {}
            Err(_) => {}
        }
        var connection = MsSqlConnection.over(tcp, config.commandTimeout())?;
        connection.reconnecting = plan.reconnecting;
        match (await connection.login(config, host, plan)) {
            Ok() => { return Ok(connection); }
            Err(e) => {
                match (connection.lastError()) {
                    Some(m) => { *transient = isTransient(m.number); }
                    null => {}
                }
                return Err(e);
            }
        }
    }

    fn over(tcp: AsyncTcpStream, commandMillis: u64) -> Result<MsSqlConnection, MsSqlError> {
        var input = Vector<u8>.create();
        allocated(input.resize(READ_CHUNK, 0))?;
        var net = Vector<u8>.create();
        allocated(net.resize(READ_CHUNK, 0))?;
        return Ok(MsSqlConnection {
            tcp: tcp,
            tls: null,
            net: net,
            cipher: Vector<u8>.create(),
            input: input,
            inStart: 0,
            inEnd: 0,
            payload: Vector<u8>.create(),
            payStart: 0,
            messageDone: false,
            ended: false,
            needBytes: 0,
            output: Vector<u8>.create(),
            wire: Vector<u8>.create(),
            packetSize: LOGIN_PACKET_SIZE,
            busy: true, // until the login completes
            sending: false,
            stream: S_IDLE,
            descriptor: 0,
            // SQL_Latin1_General_CP1_CI_AS until the server says which collation the database has.
            session: SessionText { collation: [0x09u8, 0x04, 0xD0, 0x00, 0x34], codePage: 1252 },
            meta: MsMeta.create(),
            lastDone: DoneInfo { token: 0, status: 0, command: 0, count: 0 },
            errorList: Vector<MsSqlMessage>.create(),
            infoList: Vector<MsSqlMessage>.create(),
            status: null,
            languageName: String.create(),
            recovery: noRecovery(),
            reconnecting: false,
            recoveredCount: 0,
            seqPhase: 0,
            seqColumn: 0,
            seqChunkLeft: 0,
            seqBitmap: Vector<u8>.create(),
            seqPending: Vector<u8>.create(),
            outputs: MsSqlRows.create(),
            tokenBody: Vector<u8>.create(),
            loginAcked: false,
            sspi: Vector<u8>.create(),
            version: MsServerVersion { major: 0, minor: 0, build: 0 },
            databaseName: String.create(),
            routeHost: String.create(),
            routePort: 0,
            resetPending: false,
            commandMillis: commandMillis,
            spid: 0,
            fatal: false,
            streamCount: 0,
        });
    }

    /// PRELOGIN, TLS, LOGIN7 and its answer.
    async fn login(
        borrow mut this,
        config: borrow MsSqlConfig,
        host: StringView,
        plan: MsLoginPlan,
    ) -> Result<void, MsSqlError> {
        let pin = plan.pin;
        let tlsConfig = config.tls() ?? { return Err(MsSqlError.Config); };
        let certificateHost = config.certificateHost();
        // 0: no TLS; 1: TLS for the login only; 2: TLS throughout.
        var level: u8 = 2;
        match (config.encrypt()) {
            MsEncrypt.Strict => {
                var engine = tlsEngine(tlsConfig, certificateHost)?;
                await this.handshakeRaw(mut engine)?;
                checkPin(borrow engine, pin)?;
                this.tls = engine;
                buildPreLoginOrFail(ENCRYPT_ON, config.instance(), mut this.output)?;
                await this.sendMessage(PKT_PRELOGIN)?;
                await this.readWholeMessage()?;
                parsePreLogin(this.payload.view())?;
            }
            _ => {
                let mandatory = config.encrypt() is MsEncrypt.Mandatory;
                buildPreLoginOrFail(if (mandatory) ENCRYPT_ON else ENCRYPT_OFF, config.instance(), mut this.output)?;
                await this.sendMessage(PKT_PRELOGIN)?;
                await this.readWholeMessage()?;
                let answer = parsePreLogin(this.payload.view())?;
                let server = answer.encryption;
                if (server == ENCRYPT_NOT_SUP) {
                    if (mandatory) {
                        return Err(MsSqlError.EncryptionRefused);
                    }
                    level = 0;
                } else if (server == ENCRYPT_OFF && !mandatory) {
                    level = 1;
                }
                if (level > 0) {
                    var engine = tlsEngine(tlsConfig, certificateHost)?;
                    await this.handshakeWrapped(mut engine)?;
                    checkPin(borrow engine, pin)?;
                    this.tls = engine;
                }
            }
        }
        // LOGIN7.
        let windows = config.usesWindowsLogin();
        var negotiate = Vector<u8>.create();
        if (windows) {
            if (config.user().length == 0 || config.password().length == 0) {
                return Err(MsSqlError.UnsupportedAuthentication);
            }
            allocated(ntlmNegotiate(mut negotiate))?;
        }
        var serverName = String.create();
        allocated(serverName.append(host))?;
        if (config.instance().length > 0) {
            allocated(serverName.append("\\"))?;
            allocated(serverName.append(config.instance()))?;
        }
        let fields = LoginFields {
            hostName: config.workstation(),
            userName: if (windows) "" else config.user(),
            password: if (windows) "" else config.password(),
            appName: config.applicationName(),
            serverName: serverName.view(),
            language: config.language(),
            database: config.database(),
            sspi: negotiate.view(),
            packetSize: config.packetSize(),
            readOnlyIntent: config.readOnlyIntent(),
            features: plan.features,
        };
        buildLogin7(fields, mut this.output)?;
        await this.sendMessage(PKT_LOGIN7)?;
        if (level == 1) {
            this.tls = null; // the login was the only encrypted message
        }
        this.beginResponse();
        await this.drainResponse()?;
        if (!this.loginAcked && this.sspi.length > 0) {
            // NTLM: answer the server's challenge.
            var challenge = replace(mut this.sspi, Vector<u8>.create());
            ntlmAuthenticate(
                challenge.view(),
                config.user(),
                config.domain(),
                config.password(),
                config.workstation(),
                mut this.output,
            )?;
            challenge.clear();
            await this.sendMessage(PKT_SSPI)?;
            this.beginResponse();
            await this.drainResponse()?;
        }
        if (!this.loginAcked) {
            return Err(MsSqlError.Login);
        }
        this.busy = false;
        return Ok();
    }

    // ---- TLS ----

    /// TDS 7.x: the handshake's records travel in PRELOGIN packets.
    async fn handshakeWrapped(borrow mut this, engine: borrow mut TlsEngine) -> Result<void, MsSqlError> {
        loop {
            let done = tlsResult(engine.handshake())?;
            if (engine.pendingOutput() > 0) {
                this.output.clear();
                tlsResult(engine.takeAllOutput(mut this.output))?;
                await this.sendMessage(PKT_PRELOGIN)?;
            }
            if (done) {
                return Ok();
            }
            await this.readWholeMessage()?;
            tlsResult(engine.feed(this.payload.view()))?;
            this.payload.clear();
            this.payStart = 0;
        }
    }

    /// TDS 8.0: TLS straight over TCP, before anything else.
    async fn handshakeRaw(borrow mut this, engine: borrow mut TlsEngine) -> Result<void, MsSqlError> {
        loop {
            let done = tlsResult(engine.handshake())?;
            if (engine.pendingOutput() > 0) {
                this.cipher.clear();
                tlsResult(engine.takeAllOutput(mut this.cipher))?;
                ioResult(await this.tcp.write(this.cipher.view()))?;
            }
            if (done) {
                return Ok();
            }
            let room = this.net.viewMut();
            let n = ioResult(await this.tcp.read(room))?;
            if (n == 0) {
                return Err(MsSqlError.Closed);
            }
            let got = this.net.view();
            tlsResult(engine.feed(got[0..n]))?;
        }
    }

    // ---- Bytes in and out ----

    /// Reads more of the stream into `input`, after making room for `need` unread bytes in all.
    async fn fillInput(borrow mut this, need: usize) -> Result<void, MsSqlError> {
        if (this.inStart > 0 && (this.inStart == this.inEnd || this.inStart + need > this.input.length ||
            this.inEnd == this.input.length)) {
            this.input.copyWithin(this.inStart, 0, this.inEnd - this.inStart);
            this.inEnd -= this.inStart;
            this.inStart = 0;
        }
        if (need > this.input.length) {
            allocated(this.input.resize(need, 0))?;
        } else if (this.inEnd == this.input.length) {
            allocated(this.input.resize(this.input.length * 2, 0))?;
        }
        let at = this.inEnd;
        let room = this.input.viewMut();
        var n: usize = 0;
        var secure = false;
        match (borrow mut this.tls) {
            null => { n = ioResult(await this.tcp.read(mut room[at..]))?; }
            Some(engine) => {
                secure = true;
                loop {
                    match (tlsResult(engine.read(mut room[at..]))?) {
                        Some(got) => {
                            n = got;
                            break;
                        }
                        null => {
                            let raw = this.net.viewMut();
                            let got = ioResult(await this.tcp.read(raw))?;
                            if (got == 0) {
                                return Err(MsSqlError.Closed);
                            }
                            let fed = this.net.view();
                            tlsResult(engine.feed(fed[0..got]))?;
                        }
                    }
                }
            }
        }
        if (n == 0) {
            return Err(MsSqlError.Closed);
        }
        this.inEnd += n;
        if (secure) {
            await this.flushEngine()?; // a TLS 1.3 key update may want an answer
        }
        return Ok();
    }

    /// Sends what the TLS engine has queued by itself.
    async fn flushEngine(borrow mut this) -> Result<void, MsSqlError> {
        var pending = false;
        match (borrow mut this.tls) {
            Some(engine) => {
                if (engine.pendingOutput() > 0) {
                    this.cipher.clear();
                    tlsResult(engine.takeAllOutput(mut this.cipher))?;
                    pending = true;
                }
            }
            null => {}
        }
        if (pending) {
            ioResult(await this.tcp.write(this.cipher.view()))?;
        }
        return Ok();
    }

    /// Writes the gathered packets, through TLS when it is on.
    async fn flushWire(borrow mut this) -> Result<void, MsSqlError> {
        var secure = false;
        match (borrow mut this.tls) {
            Some(engine) => {
                tlsResult(engine.write(this.wire.view()))?;
                this.cipher.clear();
                tlsResult(engine.takeAllOutput(mut this.cipher))?;
                secure = true;
            }
            null => {}
        }
        if (secure) {
            ioResult(await this.tcp.write(this.cipher.view()))?;
        } else {
            ioResult(await this.tcp.write(this.wire.view()))?;
        }
        this.wire.clear();
        return Ok();
    }

    /// Sends `output` as a message of packets of type `kind`.
    async fn sendMessage(borrow mut this, kind: u8) -> Result<void, MsSqlError> {
        this.sending = true;
        let body = this.packetSize - 8;
        let total = this.output.length;
        var at: usize = 0;
        var id: u8 = 1;
        this.wire.clear();
        loop {
            let n = if (total - at > body) body else total - at;
            let last = at + n >= total;
            var status: u8 = if (last) STATUS_EOM else 0u8;
            if (at == 0 && this.resetPending && (kind == PKT_SQL_BATCH || kind == PKT_RPC)) {
                status = status | STATUS_RESET_CONNECTION;
                this.resetPending = false;
            }
            allocated(this.wire.push(kind))?;
            allocated(this.wire.push(status))?;
            allocated(this.wire.pushBE(truncate<u16>(n + 8)))?;
            allocated(this.wire.pushBE(0u16))?; // SPID
            allocated(this.wire.push(id))?;
            allocated(this.wire.push(0))?; // window
            allocated(this.wire.extend(this.output[at..at + n]))?;
            id = id.wrappingAdd(1);
            at += n;
            // SQL Server reads one TDS packet per TLS record: each packet is encrypted on its own.
            var queued: usize = this.wire.length;
            match (borrow mut this.tls) {
                Some(engine) => {
                    tlsResult(engine.write(this.wire.view()))?;
                    this.wire.clear();
                    queued = engine.pendingOutput();
                }
                null => {}
            }
            if (last || queued >= WRITE_BATCH) {
                await this.flushWire()?;
            }
            if (last) {
                break;
            }
        }
        this.output.clear();
        this.sending = false;
        return Ok();
    }

    /// Reads the next packet and appends its payload; gives its type.
    async fn readPacket(borrow mut this) -> Result<u8, MsSqlError> {
        while (this.inEnd - this.inStart < 8) {
            await this.fillInput(8)?;
        }
        let length = this.input.view().readBE<u16>(this.inStart + 2) as usize;
        if (length < 8) {
            return Err(MsSqlError.Protocol);
        }
        while (this.inEnd - this.inStart < length) {
            await this.fillInput(length)?;
        }
        let kind = this.input[this.inStart];
        let status = this.input[this.inStart + 1];
        this.spid = this.input.view().readBE<u16>(this.inStart + 4);
        if (this.payStart > 0 && (this.payStart == this.payload.length || this.payStart >= READ_CHUNK)) {
            let end = this.payload.length;
            this.payload.copyWithin(this.payStart, 0, end - this.payStart);
            this.payload.truncate(end - this.payStart);
            this.payStart = 0;
        }
        let from = this.inStart + 8;
        allocated(this.payload.extend(this.input[from..this.inStart + length]))?;
        this.inStart += length;
        if ((status & STATUS_EOM) != 0) {
            this.messageDone = true;
        }
        return Ok(kind);
    }

    /// Reads a whole message into `payload` (from 0).
    async fn readWholeMessage(borrow mut this) -> Result<void, MsSqlError> {
        this.payload.clear();
        this.payStart = 0;
        this.messageDone = false;
        while (!this.messageDone) {
            await this.readPacket()?;
        }
        return Ok();
    }

    // ---- Tokens ----

    /// Readies for a response: forgets the last one's messages and state.
    fn beginResponse(borrow mut this) {
        this.payload.clear();
        this.payStart = 0;
        this.messageDone = false;
        this.ended = false;
        this.errorList.clear();
        this.infoList.clear();
        this.status = null;
        this.outputs.clear();
        this.meta.clear();
        this.seqPhase = 0;
    }

    /// Reads tokens until one the caller must see: a result's columns (now in `meta`), a row (stored in `rows`),
    /// a DONE (in `lastDone`), or the end of the response.
    async fn step(borrow mut this, rows: borrow mut MsSqlRows) -> Result<u8, MsSqlError> {
        loop {
            if (this.ended) {
                return Ok(EV_END);
            }
            let r = this.parseToken(rows)?;
            if (r == 0) {
                continue;
            }
            if (r == NEED) {
                if (this.messageDone) {
                    return Err(MsSqlError.Protocol); // the message ended inside a token
                }
                await this.readPacket()?;
                while (!this.messageDone && this.payload.length - this.payStart < this.needBytes) {
                    await this.readPacket()?;
                }
                continue;
            }
            if (r == EV_DONE && this.ended) {
                while (!this.messageDone) {
                    await this.readPacket()?;
                }
            }
            return Ok(r);
        }
    }

    /// Reads the token at `payStart`: 0 when it was handled here, an `EV_` code, or `NEED`.
    fn parseToken(borrow mut this, rows: borrow mut MsSqlRows) -> Result<u8, MsSqlError> {
        let at = this.payStart;
        let avail = this.payload.length - at;
        if (avail == 0) {
            this.needBytes = 1;
            return Ok(NEED);
        }
        let data = this.payload.view();
        let token = data[at];
        var need: usize = 0;
        if (token == 0xD1 || token == 0xD2) {
            match (rows.readRow(data, at + 1, borrow this.meta, token == 0xD2, mut need)?) {
                Some(end) => {
                    this.payStart = end;
                    return Ok(EV_ROW);
                }
                null => {
                    this.needBytes = 1 + need;
                    return Ok(NEED);
                }
            }
        }
        if (token == 0x81) {
            match (readColumnMetadata(data, at + 1, mut this.meta)?) {
                Some(end) => {
                    this.payStart = end;
                    return Ok(EV_COLUMNS);
                }
                null => {
                    this.needBytes = avail + 1;
                    return Ok(NEED);
                }
            }
        }
        if (token == 0xFD || token == 0xFE || token == 0xFF) {
            if (avail < 13) {
                this.needBytes = 13;
                return Ok(NEED);
            }
            let done = DoneInfo {
                token: token,
                status: data.readLE<u16>(at + 1),
                command: data.readLE<u16>(at + 3),
                count: data.readLE<u64>(at + 5),
            };
            this.payStart = at + 13;
            this.lastDone = done;
            if (token != 0xFF && (done.status & DONE_MORE) == 0) {
                this.ended = true;
            }
            return Ok(EV_DONE);
        }
        if (token == 0x79) {
            if (avail < 5) {
                this.needBytes = 5;
                return Ok(NEED);
            }
            this.status = data.readLE<i32>(at + 1);
            this.payStart = at + 5;
            return Ok(0);
        }
        if (token == 0xAC) {
            match (readReturnValue(data, at + 1, mut this.outputs, mut need)?) {
                Some(end) => {
                    this.payStart = end;
                    return Ok(0);
                }
                null => {
                    this.needBytes = if (need > 0) 1 + need else avail + 1;
                    return Ok(NEED);
                }
            }
        }
        if (token == 0xAE) {
            // FEATUREEXTACK: features (an id, a four-byte length, data) up to 0xFF.
            var pos = at + 1;
            loop {
                if (pos >= data.length) {
                    this.needBytes = avail + 1;
                    return Ok(NEED);
                }
                if (data[pos] == 0xFF) {
                    this.payStart = pos + 1;
                    return Ok(0);
                }
                if (pos + 5 > data.length) {
                    this.needBytes = avail + 1;
                    return Ok(NEED);
                }
                let length = data.readLE<u32>(pos + 1) as usize;
                if (pos + 5 + length > data.length) {
                    this.needBytes = pos + 5 + length - at;
                    return Ok(NEED);
                }
                if (data[pos] == FEATURE_SESSION_RECOVERY) {
                    var ack = Vector<u8>.create();
                    allocated(ack.extend(data[pos + 5..pos + 5 + length]))?;
                    this.recovery.acknowledge(ack.view(), this.reconnecting)?;
                }
                pos += 5 + length;
            }
        }
        if (token == 0xE4) {
            // SESSIONSTATE: a four-byte length.
            if (avail < 5) {
                this.needBytes = 5;
                return Ok(NEED);
            }
            let length = data.readLE<u32>(at + 1) as usize;
            if (avail < 5 + length) {
                this.needBytes = 5 + length;
                return Ok(NEED);
            }
            var body = Vector<u8>.create();
            allocated(body.extend(data[at + 5..at + 5 + length]))?;
            this.payStart = at + 5 + length;
            this.recovery.update(body.view())?;
            return Ok(0);
        }
        if (token == 0xAA || token == 0xAB || token == 0xE3 || token == 0xAD || token == 0xED || token == 0xA9 ||
            token == 0xA5 || token == 0xA4 || token == 0xA3) {
            // A two-byte length, then the body.
            if (avail < 3) {
                this.needBytes = 3;
                return Ok(NEED);
            }
            let length = data.readLE<u16>(at + 1) as usize;
            if (avail < 3 + length) {
                this.needBytes = 3 + length;
                return Ok(NEED);
            }
            this.tokenBody.clear();
            allocated(this.tokenBody.extend(data[at + 3..at + 3 + length]))?;
            this.payStart = at + 3 + length;
            this.handleToken(token)?;
            return Ok(0);
        }
        return Err(MsSqlError.Protocol); // ALTMETADATA, ALTROW (COMPUTE BY), or something unknown
    }

    /// Handles a small token whose body is in `tokenBody`.
    fn handleToken(borrow mut this, token: u8) -> Result<void, MsSqlError> {
        if (token == 0xAA || token == 0xAB) {
            let message = parseMessage(this.tokenBody.view())?;
            if (token == 0xAA) {
                if (message.severity >= 20) {
                    this.fatal = true;
                }
                if (this.errorList.length < MAX_ERRORS) {
                    allocated(this.errorList.push(message))?;
                }
            } else if (this.infoList.length < MAX_INFOS) {
                allocated(this.infoList.push(message))?;
            }
            return Ok();
        }
        if (token == 0xE3) {
            return this.envChange();
        }
        if (token == 0xAD) {
            // LOGINACK: interface, TDS version, program name, version.
            let body = this.tokenBody.view();
            if (body.length < 10) {
                return Err(MsSqlError.Protocol);
            }
            let nameEnd = 6 + (body[5] as usize) * 2;
            if (nameEnd + 4 > body.length) {
                return Err(MsSqlError.Protocol);
            }
            this.version = MsServerVersion {
                major: body[nameEnd],
                minor: body[nameEnd + 1],
                build: body.readBE<u16>(nameEnd + 2),
            };
            this.loginAcked = true;
            return Ok();
        }
        if (token == 0xED) {
            this.sspi.clear();
            return allocated(this.sspi.extend(this.tokenBody.view()));
        }
        return Ok(); // ORDER, COLINFO, TABNAME, DATACLASSIFICATION: not needed
    }

    /// ENVCHANGE (2.2.7.9): the session changed.
    fn envChange(borrow mut this) -> Result<void, MsSqlError> {
        let body = this.tokenBody.view();
        if (body.length < 1) {
            return Err(MsSqlError.Protocol);
        }
        let kind = body[0];
        if (kind == 1) {
            // The database: new name (B_VARCHAR), old name.
            this.databaseName.clear();
            match (readBVarchar(body, 1, body.length, mut this.databaseName)?) {
                Some(_) => {}
                null => { return Err(MsSqlError.Protocol); }
            }
        } else if (kind == 2) {
            // The language: new name (B_VARCHAR), old name.
            this.languageName.clear();
            match (readBVarchar(body, 1, body.length, mut this.languageName)?) {
                Some(_) => {}
                null => { return Err(MsSqlError.Protocol); }
            }
        } else if (kind == 4) {
            // The packet size, as text.
            var text = String.create();
            match (readBVarchar(body, 1, body.length, mut text)?) {
                Some(_) => {}
                null => { return Err(MsSqlError.Protocol); }
            }
            match (text.view().parseInt<usize>()) {
                Some(n) => {
                    if (n >= 512 && n <= 32767) {
                        this.packetSize = n;
                    }
                }
                null => {}
            }
        } else if (kind == 7) {
            // The database's collation: five bytes (B_VARBYTE).
            if (body.length >= 7 && body[1] == 5) {
                this.session.collation[..].copyFrom(body[2..7]);
                this.session.codePage = collationCodePage(body[2..7]);
            }
        } else if (kind == 8) {
            // A transaction began: its descriptor.
            if (body.length >= 10 && body[1] == 8) {
                this.descriptor = body.readLE<u64>(2);
            }
        } else if (kind == 9 || kind == 10 || kind == 17) {
            this.descriptor = 0; // committed, rolled back, or ended
        } else if (kind == 20) {
            // Routing: length (2), protocol (1, 0 = TCP), port (2), server (US_VARCHAR).
            if (body.length < 8 || body[3] != 0) {
                return Err(MsSqlError.Protocol);
            }
            this.routePort = body.readLE<u16>(4);
            let units = body.readLE<u16>(6) as usize;
            if (8 + units * 2 > body.length) {
                return Err(MsSqlError.Protocol);
            }
            this.routeHost.clear();
            allocated(Utf16.decodeInto(body[8..8 + units * 2], mut this.routeHost))?;
        }
        return Ok();
    }

    /// Reads to the end of the response, keeping nothing but its messages and state.
    async fn drainResponse(borrow mut this) -> Result<void, MsSqlError> {
        var scratch = MsSqlRows.create();
        loop {
            let ev = await this.step(mut scratch)?;
            if (ev == EV_ROW) {
                scratch.clearRows();
            } else if (ev == EV_END) {
                return Ok();
            }
        }
    }

    // ---- Exchanges ----

    /// Fails unless the connection can start an operation.
    fn ready(borrow this) -> Result<void, MsSqlError> {
        if (this.busy) {
            return Err(MsSqlError.Broken);
        }
        if (this.stream != S_IDLE) {
            return Err(MsSqlError.WrongState);
        }
        return Ok();
    }

    /// Builds the request for `sql` with `params`: an RPC to sp_executesql, or a plain batch without parameters.
    fn writeQuery(borrow mut this, sql: StringView, params: borrow MsSqlParams) -> Result<u8, MsSqlError> {
        this.ready()?;
        if (params.count() == 0) {
            allocated(putSqlBatch(mut this.output, sql, this.descriptor))?;
            return Ok(PKT_SQL_BATCH);
        }
        putExecuteSql(mut this.output, sql, params, this.descriptor, this.session)?;
        return Ok(PKT_RPC);
    }

    /// Reads the response, keeping the first result set in `first` (KEEP_FIRST), every one in `rest` (KEEP_ALL),
    /// or none; gives the rows the statements affected.
    async fn collect(
        borrow mut this,
        first: borrow mut MsSqlRows,
        rest: borrow mut Vector<MsSqlRows>,
        keep: u8,
    ) -> Result<u64, MsSqlError> {
        var scratch = MsSqlRows.create();
        // Where rows go: 0 nowhere yet, 1 `first`, 2 the last of `rest`, 3 dropped.
        var target: u8 = 0;
        var results: usize = 0;
        var total: u64 = 0;
        loop {
            let last = if (rest.length > 0) rest.length - 1 else 0usize;
            let ev = if (target == 1) await this.step(first)? else (if (target == 2) await this.step(
                mut rest[last],
            )? else await this.step(mut scratch)?);
            if (ev == EV_ROW) {
                if (target == 3 || target == 0) {
                    scratch.clearRows();
                }
            } else if (ev == EV_COLUMNS) {
                results += 1;
                if (results == 1 && keep != KEEP_NONE) {
                    first.clear();
                    first.describe(borrow this.meta)?;
                    target = 1;
                } else if (keep == KEEP_ALL) {
                    var set = MsSqlRows.create();
                    set.describe(borrow this.meta)?;
                    allocated(rest.push(set))?;
                    target = 2;
                } else {
                    scratch.clear();
                    target = 3;
                }
            } else if (ev == EV_DONE) {
                let d = this.lastDone;
                if ((d.status & DONE_COUNT) != 0) {
                    if (d.command == CMD_SELECT) {
                        if (target == 1) {
                            first.setAffected(d.count);
                        } else if (target == 2) {
                            rest[last].setAffected(d.count);
                        }
                    } else if (d.token != 0xFE) {
                        total += d.count;
                    }
                }
                if (target != 0) {
                    target = 3;
                }
            } else if (ev == EV_END) {
                break;
            }
        }
        this.busy = this.fatal;
        if (this.errorList.length > 0) {
            return Err(MsSqlError.Server);
        }
        return Ok(total);
    }

    /// Skips to the next result's columns (true), or to the end of the response (false).
    async fn advanceToResult(borrow mut this) -> Result<bool, MsSqlError> {
        var scratch = MsSqlRows.create();
        loop {
            let ev = await this.step(mut scratch)?;
            if (ev == EV_ROW) {
                scratch.clearRows();
            } else if (ev == EV_COLUMNS) {
                this.stream = S_ROWS;
                return Ok(true);
            } else if (ev == EV_DONE) {
                this.countDone();
            } else if (ev == EV_END) {
                return this.endStream();
            }
        }
    }

    fn countDone(borrow mut this) {
        let d = this.lastDone;
        if ((d.status & DONE_COUNT) != 0 && d.command != CMD_SELECT && d.token != 0xFE) {
            this.streamCount += d.count;
        }
    }

    /// The streamed response has ended.
    fn endStream(borrow mut this) -> Result<bool, MsSqlError> {
        this.stream = S_IDLE;
        this.busy = this.fatal;
        if (this.errorList.length > 0) {
            return Err(MsSqlError.Server);
        }
        return Ok(false);
    }

    /// Up to `max` rows of the current result into `rows`.
    async fn fetchRows(borrow mut this, rows: borrow mut MsSqlRows, max: usize) -> Result<bool, MsSqlError> {
        rows.clear();
        if (this.stream != S_ROWS) {
            return Ok(false);
        }
        rows.describe(borrow this.meta)?;
        loop {
            let ev = await this.step(rows)?;
            if (ev == EV_ROW) {
                if (rows.rowCount() >= max) {
                    return Ok(true);
                }
            } else if (ev == EV_COLUMNS) {
                this.stream = S_NEXT;
                return Ok(rows.rowCount() > 0);
            } else if (ev == EV_DONE) {
                let d = this.lastDone;
                if ((d.status & DONE_COUNT) != 0 && d.command == CMD_SELECT) {
                    rows.setAffected(d.count);
                }
                this.countDone();
                this.stream = S_BETWEEN;
                return Ok(rows.rowCount() > 0);
            } else if (ev == EV_END) {
                let had = rows.rowCount() > 0;
                this.endStream()?;
                return Ok(had);
            }
        }
    }

    /// One operation of the exchange, as `run` asks.
    async fn perform(
        borrow mut this,
        op: u8,
        kind: u8,
        max: usize,
        rows: borrow mut MsSqlRows,
        rest: borrow mut Vector<MsSqlRows>,
        keep: u8,
    ) -> Result<u64, MsSqlError> {
        if (op == OP_COLLECT || op == OP_START) {
            await this.sendMessage(kind)?;
            this.beginResponse();
            if (op == OP_COLLECT) {
                return await this.collect(rows, rest, keep);
            }
            this.streamCount = 0;
            return if (await this.advanceToResult()?) Ok(1u64) else Ok(0u64);
        }
        if (this.seqPhase != 0) {
            var skipped = MsSqlRows.create();
            await this.restOfRowNow(mut skipped)?;
        }
        if (op == OP_FETCH) {
            return if (await this.fetchRows(rows, max)?) Ok(1u64) else Ok(0u64);
        }
        if (op == OP_NEXT) {
            if (this.stream == S_NEXT) {
                this.stream = S_ROWS;
                return Ok(1);
            }
            var scratch = MsSqlRows.create();
            while (this.stream == S_ROWS) {
                await this.fetchRows(mut scratch, 1024)?;
            }
            if (this.stream == S_NEXT) {
                this.stream = S_ROWS;
                return Ok(1);
            }
            if (this.stream == S_BETWEEN) {
                return if (await this.advanceToResult()?) Ok(1u64) else Ok(0u64);
            }
            return Ok(0);
        }
        // OP_FINISH: read everything left.
        var scratch = MsSqlRows.create();
        while (this.stream != S_IDLE) {
            if (this.stream == S_NEXT) {
                this.stream = S_ROWS;
            }
            if (this.stream == S_ROWS) {
                await this.fetchRows(mut scratch, 1024)?;
            } else {
                await this.advanceToResult()?;
            }
        }
        return Ok(this.streamCount);
    }

    /// Runs `perform` under the command timeout, and leaves the connection in a known state whatever happens.
    async fn run(
        borrow mut this,
        op: u8,
        kind: u8,
        max: usize,
        rows: borrow mut MsSqlRows,
        rest: borrow mut Vector<MsSqlRows>,
        keep: u8,
    ) -> Result<u64, MsSqlError> {
        if (op == OP_COLLECT || op == OP_START) {
            await this.recoverIfDropped()?;
            this.busy = true;
        }
        let ms = this.commandMillis;
        let outcome: Result<u64, MsSqlError> = if (ms == 0) await this.perform(op, kind, max, rows, rest, keep)
            else await Async.timeout(
                ms,
                MsSqlError.TimedOut,
                async () => await this.perform(op, kind, max, rows, rest, keep),
            );
        match (outcome) {
            Ok(v) => { return Ok(v); }
            Err(MsSqlError.Server) => { return Err(MsSqlError.Server); }
            Err(MsSqlError.TimedOut) => {
                if (!this.sending) {
                    match (await this.recoverWithin()) {
                        Ok() => {}
                        Err(_) => {
                            this.busy = true;
                            this.stream = S_IDLE;
                        }
                    }
                } else {
                    this.busy = true;
                    this.stream = S_IDLE;
                }
                return Err(MsSqlError.TimedOut);
            }
            Err(e) => {
                this.busy = true; // the stream is out of step
                this.stream = S_IDLE;
                return Err(e);
            }
        }
    }

    /// Sends an attention and reads up to its acknowledgement, within `ATTENTION_TIMEOUT_MS`.
    async fn recoverWithin(borrow mut this) -> Result<void, MsSqlError> {
        return await Async.timeout(ATTENTION_TIMEOUT_MS, MsSqlError.TimedOut, async () => await this.attention());
    }

    /// An attention (2.2.1.7): the server stops the request and answers with a DONE carrying DONE_ATTN, after
    /// whatever of the response it had sent.
    async fn attention(borrow mut this) -> Result<void, MsSqlError> {
        this.output.clear();
        await this.sendMessage(PKT_ATTENTION)?;
        var scratch = MsSqlRows.create();
        loop {
            if (this.ended) {
                // The response is over; the acknowledgement comes in a message of its own.
                if (this.payStart < this.payload.length) {
                    return Err(MsSqlError.Protocol);
                }
                this.ended = false;
                this.messageDone = false;
            }
            let ev = await this.step(mut scratch)?;
            if (ev == EV_ROW) {
                scratch.clearRows();
            } else if (ev == EV_DONE && (this.lastDone.status & DONE_ATTN) != 0) {
                while (!this.messageDone) {
                    await this.readPacket()?;
                }
                this.payload.clear();
                this.payStart = 0;
                this.ended = true;
                this.stream = S_IDLE;
                this.busy = this.fatal;
                return Ok();
            }
        }
    }

    // ---- Queries ----

    /// Runs `sql` with `params` and gives the first result set's rows (an empty `MsSqlRows` when it returns
    /// none). Further result sets are read and dropped; use `queryAll` to keep them.
    public async fn query(
        borrow mut this,
        sql: StringView,
        params: borrow MsSqlParams,
    ) -> Result<MsSqlRows, MsSqlError> {
        var rows = MsSqlRows.create();
        await this.queryInto(sql, params, mut rows)?;
        return Ok(rows);
    }

    /// As `query`, into `rows`, which is cleared first; reusing one `MsSqlRows` reuses its memory.
    public async fn queryInto(
        borrow mut this,
        sql: StringView,
        params: borrow MsSqlParams,
        rows: borrow mut MsSqlRows,
    ) -> Result<void, MsSqlError> {
        let kind = this.writeQuery(sql, params)?;
        rows.clear();
        var rest = Vector<MsSqlRows>.create();
        await this.run(OP_COLLECT, kind, 0, rows, mut rest, KEEP_FIRST)?;
        return Ok();
    }

    /// Runs `sql` with `params` and gives every result set, the output parameters and the rows affected.
    public async fn queryAll(
        borrow mut this,
        sql: StringView,
        params: borrow MsSqlParams,
    ) -> Result<MsSqlResults, MsSqlError> {
        let kind = this.writeQuery(sql, params)?;
        return await this.collectResults(kind);
    }

    async fn collectResults(borrow mut this, kind: u8) -> Result<MsSqlResults, MsSqlError> {
        var results = MsSqlResults.create();
        var first = MsSqlRows.create();
        var rest = Vector<MsSqlRows>.create();
        results.affected = await this.run(OP_COLLECT, kind, 0, mut first, mut rest, KEEP_ALL)?;
        // `first` holds the first result set and `rest` the others.
        var all = Vector<MsSqlRows>.create();
        if (first.columnCount() > 0 || rest.length > 0) {
            allocated(all.push(first))?;
        }
        loop {
            match (rest.pop()) {
                Some(r) => { allocated(all.push(r))?; }
                null => { break; }
            }
        }
        // `rest` popped in reverse; put the sets after the first back in order.
        if (all.length > 2) {
            var lo: usize = 1;
            var hi = all.length - 1;
            while (lo < hi) {
                all.swap(lo, hi);
                lo += 1;
                hi -= 1;
            }
        }
        results.sets = all;
        results.out = replace(mut this.outputs, MsSqlRows.create());
        results.status = this.status;
        return Ok(results);
    }

    /// Runs `sql` with `params` for its effect, and gives the number of rows its INSERT, UPDATE, DELETE and MERGE
    /// statements affected (0 under `SET NOCOUNT ON`). Rows a SELECT returns are read and dropped.
    public async fn execute(borrow mut this, sql: StringView, params: borrow MsSqlParams) -> Result<u64, MsSqlError> {
        let kind = this.writeQuery(sql, params)?;
        var none = MsSqlRows.create();
        var rest = Vector<MsSqlRows>.create();
        return await this.run(OP_COLLECT, kind, 0, mut none, mut rest, KEEP_NONE);
    }

    /// Runs `sql`, a batch without parameters: DDL, a script of several statements, `SET` options.
    public async fn batch(borrow mut this, sql: StringView) -> Result<u64, MsSqlError> {
        let none = MsSqlParams.create();
        return await this.execute(sql, none);
    }

    /// Describes the result `sql` would give with `params`, without running it (as GetSchemaTable with KeyInfo):
    /// one row per column, from `sp_describe_first_result_set` in browse mode. Its columns include `name`,
    /// `is_nullable`, `system_type_name` (`nvarchar(50)`), `max_length`, `precision`, `scale`, `collation_name`,
    /// `source_database`, `source_schema`, `source_table` and `source_column` (where the column comes from),
    /// `is_identity_column`, `is_computed_column`, `is_updateable`, `is_part_of_unique_key` and `is_hidden` (a key
    /// column the query did not ask for, added so that each row can be told apart). Only the parameters' types
    /// matter, not their values. Look the columns up by name: `rows.columnIndex("source_table")`.
    ///
    /// ```ceesafe
    /// let shape = await db.describeResult("SELECT o.id, c.name FROM orders o JOIN customers c ON …", none)?;
    /// for (r in 0..shape.rowCount()) {
    ///     let column = shape.text(r, shape.columnIndex("name")!);
    ///     let table = shape.text(r, shape.columnIndex("source_table")!);   // orders, customers
    /// }
    /// ```
    public async fn describeResult(
        borrow mut this,
        sql: StringView,
        params: borrow MsSqlParams,
    ) -> Result<MsSqlRows, MsSqlError> {
        var declarations = Vector<u8>.create();
        allocated(appendDeclarations(params, mut declarations))?;
        var p = MsSqlParams.create();
        p.name("@tsql");
        p.text(sql)?;
        p.name("@params");
        p.text(StringView.fromUtf8(declarations.view()) ?? "")?;
        p.name("@browse_information_mode");
        p.uint8(1)?;
        let results = await this.callProcedure("sys.sp_describe_first_result_set", p)?;
        if (results.count() == 0) {
            return Err(MsSqlError.Protocol);
        }
        var all = results;
        return Ok(replace(mut all.sets[0], MsSqlRows.create()));
    }

    /// Calls stored procedure `name` with `params`, which are passed by name (`params.name("@id")` before each);
    /// output parameters (`params.output()`) come back in `outputs()`, the `RETURN` value in `returnStatus()`.
    public async fn callProcedure(
        borrow mut this,
        name: StringView,
        params: borrow MsSqlParams,
    ) -> Result<MsSqlResults, MsSqlError> {
        this.ready()?;
        putProcedureCall(mut this.output, name, params, this.descriptor, this.session)?;
        return await this.collectResults(PKT_RPC);
    }

    /// Runs every command of `batch` as one request, in order, and gives each one's results (SqlBatch). A command
    /// that fails does not stop the ones after it, as the server runs each on its own; the call then fails with
    /// `Server` once the response is read, and `errors()` has every error.
    public async fn executeBatch(borrow mut this, batch: borrow MsSqlBatch) -> Result<MsSqlBatchResults, MsSqlError> {
        this.ready()?;
        if (batch.count() == 0) {
            return Ok(MsSqlBatchResults.of(Vector<MsSqlResults>.create()));
        }
        putBatch(mut this.output, batch, this.descriptor, this.session)?;
        await this.recoverIfDropped()?;
        this.busy = true;
        let ms = this.commandMillis;
        let outcome = if (ms == 0) await this.performBatch()
            else await Async.timeout(ms, MsSqlError.TimedOut, async () => await this.performBatch());
        match (outcome) {
            Ok(r) => { return Ok(r); }
            Err(MsSqlError.Server) => { return Err(MsSqlError.Server); }
            Err(MsSqlError.TimedOut) => {
                if (this.sending) {
                    this.stream = S_IDLE;
                } else {
                    match (await this.recoverWithin()) {
                        Ok() => {}
                        Err(_) => { this.stream = S_IDLE; }
                    }
                }
                return Err(MsSqlError.TimedOut);
            }
            Err(e) => {
                this.stream = S_IDLE;
                return Err(e);
            }
        }
    }

    /// Sends the batch and reads its response, closing a command's results at each DONEPROC.
    async fn performBatch(borrow mut this) -> Result<MsSqlBatchResults, MsSqlError> {
        await this.sendMessage(PKT_RPC)?;
        this.beginResponse();
        var done = Vector<MsSqlResults>.create();
        var current = MsSqlResults.create();
        var sets = Vector<MsSqlRows>.create();
        var scratch = MsSqlRows.create();
        var inSet = false;
        loop {
            let last = if (sets.length > 0) sets.length - 1 else 0usize;
            let ev = if (inSet) await this.step(mut sets[last])? else await this.step(mut scratch)?;
            if (ev == EV_ROW) {
                if (!inSet) {
                    scratch.clearRows();
                }
            } else if (ev == EV_COLUMNS) {
                var set = MsSqlRows.create();
                set.describe(borrow this.meta)?;
                allocated(sets.push(set))?;
                inSet = true;
            } else if (ev == EV_DONE) {
                let d = this.lastDone;
                if ((d.status & DONE_COUNT) != 0) {
                    if (d.command == CMD_SELECT) {
                        if (inSet) {
                            sets[last].setAffected(d.count);
                        }
                    } else if (d.token != 0xFE) {
                        current.affected += d.count;
                    }
                }
                inSet = false;
                if (d.token == 0xFE) {
                    // DONEPROC: this command is over.
                    current.sets = replace(mut sets, Vector<MsSqlRows>.create());
                    current.out = replace(mut this.outputs, MsSqlRows.create());
                    current.status = this.status;
                    this.status = null;
                    allocated(done.push(replace(mut current, MsSqlResults.create())))?;
                }
            } else if (ev == EV_END) {
                break;
            }
        }
        this.busy = this.fatal;
        if (this.errorList.length > 0) {
            return Err(MsSqlError.Server);
        }
        return Ok(MsSqlBatchResults.of(done));
    }

    /// Loads `rows` into table `table` (`dbo.Orders`, `[sales].[Order Lines]`, `#work`) as SqlBulkCopy does: an
    /// `INSERT BULK` naming `rows`' columns, then the rows in TDS's bulk format, far faster than one INSERT per row.
    /// Columns the table has and `rows` does not get their defaults. Gives how many rows the server took; a
    /// constraint or type error fails the whole call (`Server`), and inside a transaction it can be rolled back.
    ///
    /// ```ceesafe
    /// var rows = MsSqlTable.create();
    /// rows.column("id", MsSqlType.Int)?;
    /// rows.textColumn("name", 100)?;
    /// for (k in 0..10000) {
    ///     rows.int32(k)?;
    ///     rows.text("a row")?;
    /// }
    /// let loaded = await db.bulkInsert("dbo.Orders", rows, MsBulkOptions.defaults())?;
    /// ```
    ///
    /// The rows travel as one message, so a load of millions is best sent in parts: `clearRows()` and refill.
    public async fn bulkInsert(
        borrow mut this,
        table: StringView,
        rows: borrow MsSqlTable,
        options: MsBulkOptions,
    ) -> Result<u64, MsSqlError> {
        this.ready()?;
        if (!rows.complete()) {
            return Err(MsSqlError.Config);
        }
        var sql = Vector<u8>.create();
        allocated(sql.extend("INSERT BULK ".bytes()))?;
        if (!allocated2(quoteName(table, 3, mut sql))?) {
            return Err(MsSqlError.Config);
        }
        allocated(appendBulkColumns(rows, mut sql))?;
        var with = Vector<u8>.create();
        if (options.tableLock) {
            allocated(with.extend("TABLOCK, ".bytes()))?;
        }
        if (options.checkConstraints) {
            allocated(with.extend("CHECK_CONSTRAINTS, ".bytes()))?;
        }
        if (options.fireTriggers) {
            allocated(with.extend("FIRE_TRIGGERS, ".bytes()))?;
        }
        if (options.keepNulls) {
            allocated(with.extend("KEEP_NULLS, ".bytes()))?;
        }
        if (options.keepIdentity) {
            allocated(with.extend("KEEPIDENTITY, ".bytes()))?;
        }
        if (with.length > 0) {
            allocated(sql.extend(" WITH (".bytes()))?;
            allocated(sql.extend(with[0..with.length - 2]))?;
            allocated(sql.push(')'))?;
        }
        if (rows.rowCount() == 0) {
            return Ok(0);
        }
        // The target's columns, as the server describes them: which take NULL. This also checks the names first.
        var probe = Vector<u8>.create();
        allocated(probe.extend("SELECT TOP (0) ".bytes()))?;
        var first = true;
        for (c in rows.columnList()) {
            if (!first) {
                allocated(probe.extend(", ".bytes()))?;
            }
            first = false;
            allocated(probe.push('['))?;
            allocated(probe.extend(rows.columnName(c).bytes()))?;
            allocated(probe.push(']'))?;
        }
        allocated(probe.extend(" FROM ".bytes()))?;
        let _ = allocated2(quoteName(table, 3, mut probe))?;
        let noParams = MsSqlParams.create();
        let target = await this.query(StringView.fromUtf8(probe.view()) ?? "", noParams)?;
        var nullable = Vector<bool>.create();
        for (k in 0..target.columnCount()) {
            allocated(nullable.push(target.columnNullable(k)))?;
        }
        if (nullable.length != rows.columnCount()) {
            return Err(MsSqlError.Protocol);
        }
        await this.batch(StringView.fromUtf8(sql.view()) ?? "")?;
        putBulkLoad(mut this.output, rows, nullable.view(), this.session)?;
        var none = MsSqlRows.create();
        var rest = Vector<MsSqlRows>.create();
        return await this.run(OP_COLLECT, PKT_BULK_LOAD, 0, mut none, mut rest, KEEP_NONE);
    }

    /// Runs `sql` (a `SELECT … FOR JSON`) and appends its JSON text to `out`. The server splits long JSON over
    /// several rows of its first column; they are joined here.
    public async fn queryJson(
        borrow mut this,
        sql: StringView,
        params: borrow MsSqlParams,
        out: borrow mut String,
    ) -> Result<void, MsSqlError> {
        let rows = await this.query(sql, params)?;
        for (r in 0..rows.rowCount()) {
            match (rows.text(r, 0)) {
                Some(t) => { allocated(out.append(t))?; }
                null => {}
            }
        }
        return Ok();
    }

    // ---- Streaming ----

    /// Starts `sql` with `params` without reading its rows yet: then `fetch` gives them in batches, `nextResult`
    /// moves to the next result set, and `finish` reads what is left. True when the first result set is ready;
    /// false when the batch returned no rows at all (it has then ended). No other operation can run until the
    /// stream ends.
    public async fn start(borrow mut this, sql: StringView, params: borrow MsSqlParams) -> Result<bool, MsSqlError> {
        let kind = this.writeQuery(sql, params)?;
        var none = MsSqlRows.create();
        var rest = Vector<MsSqlRows>.create();
        return Ok(await this.run(OP_START, kind, 0, mut none, mut rest, KEEP_NONE)? == 1);
    }

    /// Replaces `rows` with up to `max` (at least 1) further rows of the current result set; false once it has
    /// none left (`rows` is then empty).
    public async fn fetch(borrow mut this, rows: borrow mut MsSqlRows, max: usize) -> Result<bool, MsSqlError> {
        if (this.busy && this.stream == S_IDLE) {
            return Err(MsSqlError.Broken);
        }
        var rest = Vector<MsSqlRows>.create();
        let limit = if (max == 0) 1usize else max;
        return Ok(await this.run(OP_FETCH, 0, limit, rows, mut rest, KEEP_NONE)? == 1);
    }

    /// Moves to the next result set, skipping the rest of the current one: true when there is one.
    public async fn nextResult(borrow mut this) -> Result<bool, MsSqlError> {
        if (this.stream == S_IDLE) {
            return Ok(false);
        }
        var none = MsSqlRows.create();
        var rest = Vector<MsSqlRows>.create();
        return Ok(await this.run(OP_NEXT, 0, 0, mut none, mut rest, KEEP_NONE)? == 1);
    }

    /// Reads what is left of a streamed response, and gives the rows its statements affected. `Server` if a
    /// statement failed.
    public async fn finish(borrow mut this) -> Result<u64, MsSqlError> {
        if (this.stream == S_IDLE) {
            return Ok(this.streamCount);
        }
        var none = MsSqlRows.create();
        var rest = Vector<MsSqlRows>.create();
        return await this.run(OP_FINISH, 0, 0, mut none, mut rest, KEEP_NONE);
    }

    /// Stops a streamed response early: the server is told to stop (an attention), what it already sent is
    /// skipped, and the connection is ready again. Cheaper than `finish` when much is left.
    public async fn cancel(borrow mut this) -> Result<void, MsSqlError> {
        if (this.stream == S_IDLE) {
            return Ok();
        }
        this.seqPhase = 0;
        match (await this.recoverWithin()) {
            Ok() => { return Ok(); }
            Err(e) => {
                this.busy = true;
                this.stream = S_IDLE;
                return Err(e);
            }
        }
    }

    // ---- Streaming a large value ----

    /// Reads the next row of a streamed result (`start`) up to its first `(max)` value, which it leaves unread for
    /// `readChunk` or `readText` to take piece by piece: a value of gigabytes then needs no more memory than a
    /// packet. `head` gets the row, with that column and the ones after it NULL until `restOfRow` reads the ones
    /// after it. A row without a `(max)` column is read whole. False at the end of the result set, as for `fetch`.
    ///
    /// ```ceesafe
    /// await db.start("SELECT id, name, content FROM dbo.files", none)?;
    /// var head = MsSqlRows.create();
    /// var buffer = [0u8; 65536];
    /// while (await db.nextRow(mut head)?) {
    ///     let id = head.int64(0, 0);
    ///     loop {
    ///         let n = await db.readChunk(mut buffer[..])?;  // the bytes of `content`, as sent
    ///         if (n == 0) {
    ///             break;
    ///         }
    ///         // write buffer[0..n] somewhere
    ///     }
    /// }
    /// await db.finish()?;
    /// ```
    ///
    /// Reading the next row, `fetch`, `nextResult` or `finish` skips what is left of the value and of the row.
    public async fn nextRow(borrow mut this, head: borrow mut MsSqlRows) -> Result<bool, MsSqlError> {
        let ms = this.commandMillis;
        let outcome = if (ms == 0) await this.nextRowNow(head)
            else await Async.timeout(ms, MsSqlError.TimedOut, async () => await this.nextRowNow(head));
        match (outcome) {
            Ok(v) => { return Ok(v); }
            Err(e) => { return Err(await this.settle(e)); }
        }
    }

    /// Up to `buffer.length` more bytes of the value `nextRow` left unread, as the server sends them: UTF-16 for
    /// `nvarchar(max)`, the code page's bytes for `varchar(max)`, the bytes of `varbinary(max)`. 0 at its end (and
    /// when no value is being streamed).
    public async fn readChunk(borrow mut this, buffer: SliceMut<u8>) -> Result<usize, MsSqlError> {
        if (buffer.length == 0) {
            return Err(MsSqlError.Config);
        }
        let ms = this.commandMillis;
        let outcome = if (ms == 0) await this.readChunkNow(buffer)
            else await Async.timeout(ms, MsSqlError.TimedOut, async () => await this.readChunkNow(buffer));
        match (outcome) {
            Ok(v) => { return Ok(v); }
            Err(e) => { return Err(await this.settle(e)); }
        }
    }

    /// Appends the next piece of the text value `nextRow` left unread to `out`, as UTF-8; false at its end. A
    /// character split between pieces is kept whole for the next one. `WrongState` for a binary value.
    public async fn readText(borrow mut this, out: borrow mut String) -> Result<bool, MsSqlError> {
        let ms = this.commandMillis;
        let outcome = if (ms == 0) await this.readTextNow(out)
            else await Async.timeout(ms, MsSqlError.TimedOut, async () => await this.readTextNow(out));
        match (outcome) {
            Ok(v) => { return Ok(v); }
            Err(e) => { return Err(await this.settle(e)); }
        }
    }

    /// Reads the columns after the streamed one into `head` (skipping what is left of the value).
    public async fn restOfRow(borrow mut this, head: borrow mut MsSqlRows) -> Result<void, MsSqlError> {
        let ms = this.commandMillis;
        let outcome = if (ms == 0) await this.restOfRowNow(head)
            else await Async.timeout(ms, MsSqlError.TimedOut, async () => await this.restOfRowNow(head));
        match (outcome) {
            Ok() => { return Ok(); }
            Err(e) => { return Err(await this.settle(e)); }
        }
    }

    /// Leaves the connection in a known state after a streaming operation failed with `e`, as `run` does.
    async fn settle(borrow mut this, e: MsSqlError) -> MsSqlError {
        this.seqPhase = 0;
        match (e) {
            MsSqlError.Server => {}
            MsSqlError.TimedOut => {
                match (await this.recoverWithin()) {
                    Ok() => {}
                    Err(_) => {
                        this.busy = true;
                        this.stream = S_IDLE;
                    }
                }
            }
            _ => {
                this.busy = true;
                this.stream = S_IDLE;
            }
        }
        return e;
    }

    /// Reads packets until `count` bytes are there from `payStart`.
    async fn waitBytes(borrow mut this, count: usize) -> Result<void, MsSqlError> {
        while (this.payload.length - this.payStart < count) {
            if (this.messageDone) {
                return Err(MsSqlError.Protocol);
            }
            await this.readPacket()?;
        }
        return Ok();
    }

    async fn nextRowNow(borrow mut this, head: borrow mut MsSqlRows) -> Result<bool, MsSqlError> {
        if (this.busy && this.stream == S_IDLE) {
            return Err(MsSqlError.Broken);
        }
        if (this.stream != S_ROWS) {
            return Ok(false);
        }
        var scratch = MsSqlRows.create();
        if (this.seqPhase != 0) {
            await this.restOfRowNow(mut scratch)?;
        }
        head.clear();
        head.describe(borrow this.meta)?;
        loop {
            if (this.ended) {
                this.endStream()?;
                return Ok(false);
            }
            if (this.payload.length == this.payStart) {
                await this.waitBytes(1)?;
            }
            let token = this.payload[this.payStart];
            if (token == 0xD1 || token == 0xD2) {
                return await this.beginRow(head, token == 0xD2);
            }
            // Anything else, as `step` reads it.
            let r = this.parseToken(mut scratch)?;
            if (r == 0) {
                continue;
            }
            if (r == NEED) {
                await this.waitBytes(this.needBytes)?;
                continue;
            }
            if (r == EV_DONE && this.ended) {
                while (!this.messageDone) {
                    await this.readPacket()?;
                }
            }
            if (r == EV_COLUMNS) {
                this.stream = S_NEXT;
                return Ok(false);
            }
            if (r == EV_DONE) {
                this.countDone();
                this.stream = S_BETWEEN;
                return Ok(false);
            }
            if (r == EV_END) {
                this.endStream()?;
                return Ok(false);
            }
        }
    }

    /// The row at `payStart` up to its first PLP value. Offsets are kept from `payStart`, which a packet read may
    /// move (it compacts the payload), and `payStart` moves only once a part is whole.
    async fn beginRow(borrow mut this, head: borrow mut MsSqlRows, nullBitmap: bool) -> Result<bool, MsSqlError> {
        let n = this.meta.columns.length;
        var k = n;
        for (i in 0..n) {
            if (this.meta.columns[i].layout == L_PLP) {
                k = i;
                break;
            }
        }
        let bitmapLength = if (nullBitmap) (n + 7) / 8 else 0usize;
        await this.waitBytes(1 + bitmapLength)?;
        this.seqBitmap.clear();
        allocated(this.seqBitmap.extend(this.payload[this.payStart + 1..this.payStart + 1 + bitmapLength]))?;
        this.payStart += 1 + bitmapLength;
        await this.readColumnsInto(head, 0, k)?;
        if (k == n) {
            head.endRow();
            return Ok(true);
        }
        let isNull = this.seqBitmap.length > 0 && (this.seqBitmap[k / 8] & (1u8 << truncate<u8>(k % 8))) != 0;
        var total: u64 = 0xFFFFFFFFFFFFFFFF;
        if (!isNull) {
            await this.waitBytes(8)?;
            total = this.payload.view().readLE<u64>(this.payStart);
            this.payStart += 8;
        }
        head.pushNull()?;
        if (total == 0xFFFFFFFFFFFFFFFF) {
            // A NULL value: nothing to stream, the rest of the row is read now.
            await this.readColumnsInto(head, k + 1, n)?;
            head.endRow();
            return Ok(true);
        }
        for (i in k + 1..n) {
            head.pushNull()?;
        }
        head.endRow();
        this.seqPhase = 1;
        this.seqColumn = k;
        this.seqChunkLeft = 0;
        this.seqPending.clear();
        return Ok(true);
    }

    /// Columns `from` to `to` of the row at `payStart` into `rows`, waiting for packets as needed.
    async fn readColumnsInto(
        borrow mut this,
        rows: borrow mut MsSqlRows,
        from: usize,
        to: usize,
    ) -> Result<void, MsSqlError> {
        loop {
            var need: usize = 0;
            match (rows.readColumns(
                this.payload.view(),
                this.payStart,
                borrow this.meta,
                from,
                to,
                this.seqBitmap.view(),
                mut need,
            )?) {
                Some(end) => {
                    this.payStart = end;
                    return Ok();
                }
                null => { await this.waitBytes(if (need == 0) this.payload.length - this.payStart + 1 else need)?; }
            }
        }
    }

    async fn readChunkNow(borrow mut this, buffer: SliceMut<u8>) -> Result<usize, MsSqlError> {
        if (this.seqPhase != 1) {
            return Ok(0);
        }
        if (this.seqChunkLeft == 0) {
            await this.waitBytes(4)?;
            let chunk = this.payload.view().readLE<u32>(this.payStart) as usize;
            this.payStart += 4;
            if (chunk == 0) {
                this.seqPhase = 2;
                return Ok(0);
            }
            this.seqChunkLeft = chunk;
        }
        await this.waitBytes(1)?;
        var n = this.payload.length - this.payStart;
        if (n > this.seqChunkLeft) {
            n = this.seqChunkLeft;
        }
        if (n > buffer.length) {
            n = buffer.length;
        }
        buffer[0..n].copyFrom(this.payload[this.payStart..this.payStart + n]);
        this.payStart += n;
        this.seqChunkLeft -= n;
        return Ok(n);
    }

    async fn readTextNow(borrow mut this, out: borrow mut String) -> Result<bool, MsSqlError> {
        if (this.seqPhase != 1) {
            return Ok(false);
        }
        let column = this.meta.columns[this.seqColumn];
        if (column.encoding == ENC_NONE) {
            return Err(MsSqlError.WrongState);
        }
        var piece = [0u8; 8192];
        loop {
            let n = await this.readChunkNow(mut piece[..])?;
            if (n == 0) {
                // The end: a character cut short is a replacement character.
                if (this.seqPending.length > 0) {
                    allocated(out.append("\u{FFFD}"))?;
                    this.seqPending.clear();
                }
                return Ok(false);
            }
            allocated(this.seqPending.extend(piece[0..n]))?;
            let pending = this.seqPending.view();
            var cut = pending.length;
            if (column.encoding == ENC_UTF16) {
                cut = cut - cut % 2;
                if (cut >= 2) {
                    let unit = pending.readLE<u16>(cut - 2);
                    if (unit >= 0xD800 && unit <= 0xDBFF) {
                        cut -= 2; // a high surrogate waits for its pair
                    }
                }
            } else if (column.codePage == 65001) {
                cut = utf8Boundary(pending);
            }
            if (cut == 0) {
                continue;
            }
            if (column.encoding == ENC_UTF16) {
                allocated(Utf16.decodeInto(pending[0..cut], out))?;
            } else {
                var decoded = Vector<u8>.create();
                allocated(CodePages.decode(column.codePage, pending[0..cut], mut decoded))?;
                allocated(out.append(StringView.fromUtf8(decoded.view()) ?? ""))?;
            }
            let rest = this.seqPending.length - cut;
            this.seqPending.copyWithin(cut, 0, rest);
            this.seqPending.truncate(rest);
            return Ok(true);
        }
    }

    async fn restOfRowNow(borrow mut this, rows: borrow mut MsSqlRows) -> Result<void, MsSqlError> {
        if (this.seqPhase == 0) {
            return Ok();
        }
        var sink = [0u8; 8192];
        while (this.seqPhase == 1) {
            let _ = await this.readChunkNow(mut sink[..])?;
        }
        let n = this.meta.columns.length;
        let k = this.seqColumn;
        if (rows.columnCount() == n && rows.rowCount() == 1) {
            rows.cutCells(k + 1);
        } else {
            rows.clear();
            rows.describe(borrow this.meta)?;
            for (i in 0..k + 1) {
                rows.pushNull()?;
            }
        }
        await this.readColumnsInto(rows, k + 1, n)?;
        this.seqPhase = 0;
        return Ok();
    }

    // ---- Backups ----

    /// `BACKUP DATABASE` `database` to the file `path` on the server's disk, with `FORMAT` (a new media set) and
    /// `COMPRESSION` when asked. The name and the path travel as parameters, never spliced into the SQL.
    public async fn backupDatabase(
        borrow mut this,
        database: StringView,
        path: StringView,
        compression: bool,
        format: bool,
    ) -> Result<void, MsSqlError> {
        var p = MsSqlParams.create();
        p.text(database)?;
        p.text(path)?;
        let sql =
            if (compression && format) "BACKUP DATABASE @p1 TO DISK = @p2 WITH FORMAT, COMPRESSION"
                else (if (compression) "BACKUP DATABASE @p1 TO DISK = @p2 WITH COMPRESSION"
                    else (if (format) "BACKUP DATABASE @p1 TO DISK = @p2 WITH FORMAT"
                        else "BACKUP DATABASE @p1 TO DISK = @p2"));
        await this.execute(sql, p)?;
        return Ok();
    }

    /// `RESTORE DATABASE` `database` from the backup file `path` on the server's disk, `WITH REPLACE`.
    public async fn restoreDatabase(
        borrow mut this,
        database: StringView,
        path: StringView,
    ) -> Result<void, MsSqlError> {
        var p = MsSqlParams.create();
        p.text(database)?;
        p.text(path)?;
        await this.execute("RESTORE DATABASE @p1 FROM DISK = @p2 WITH REPLACE", p)?;
        return Ok();
    }

    // ---- Transactions ----

    /// Begins a transaction at the session's isolation level (READ COMMITTED unless changed).
    public async fn begin(borrow mut this) -> Result<void, MsSqlError> {
        await this.batch("BEGIN TRANSACTION")?;
        return Ok();
    }

    /// Sets the session's isolation level to `level`, then begins a transaction. The level stays with the session
    /// after the transaction (a pooled connection is reset when its lease ends).
    public async fn beginWith(borrow mut this, level: MsIsolation) -> Result<void, MsSqlError> {
        let sql = match (level) {
            MsIsolation.ReadUncommitted => "SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED; BEGIN TRANSACTION",
            MsIsolation.ReadCommitted => "SET TRANSACTION ISOLATION LEVEL READ COMMITTED; BEGIN TRANSACTION",
            MsIsolation.RepeatableRead => "SET TRANSACTION ISOLATION LEVEL REPEATABLE READ; BEGIN TRANSACTION",
            MsIsolation.Serializable => "SET TRANSACTION ISOLATION LEVEL SERIALIZABLE; BEGIN TRANSACTION",
            MsIsolation.Snapshot => "SET TRANSACTION ISOLATION LEVEL SNAPSHOT; BEGIN TRANSACTION",
        };
        await this.batch(sql)?;
        return Ok();
    }

    /// Commits the open transaction; `WrongState` when none is open.
    public async fn commit(borrow mut this) -> Result<void, MsSqlError> {
        if (this.descriptor == 0) {
            return Err(MsSqlError.WrongState);
        }
        await this.batch("COMMIT TRANSACTION")?;
        return Ok();
    }

    /// Rolls the open transaction back; `WrongState` when none is open.
    public async fn rollback(borrow mut this) -> Result<void, MsSqlError> {
        if (this.descriptor == 0) {
            return Err(MsSqlError.WrongState);
        }
        await this.batch("IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION")?;
        return Ok();
    }

    /// Whether a transaction is open, by `begin` or by the SQL itself.
    public fn inTransaction(borrow this) -> bool => this.descriptor != 0;

    // ---- State ----

    /// Every ERROR message of the last operation, in the order the server sent them.
    public fn errors(borrow this) -> Slice<MsSqlMessage> => this.errorList.view();

    /// The first ERROR message of the last operation (usually the one that matters), or null.
    public fn lastError(borrow this) -> (borrow MsSqlMessage)? {
        if (this.errorList.length == 0) {
            return null;
        }
        return borrow this.errorList[0];
    }

    /// The informational messages of the last operation: `PRINT` output, `RAISERROR` below severity 11, the
    /// login's "changed database context".
    public fn messages(borrow this) -> Slice<MsSqlMessage> => this.infoList.view();

    /// How many times this connection recovered its session: logged in again, with its state restored, after the
    /// server or the network dropped it while idle.
    public fn recoveries(borrow this) -> u32 => this.recoveredCount;

    /// Before a request (already written to `output`): if the server dropped this idle connection and its session
    /// can be recovered, logs in again with the session's state (ConnectRetryCount attempts, ConnectRetryInterval
    /// apart) and takes the new connection's place, the request kept. A connection in a transaction, or whose
    /// session holds a state the server cannot recover, is not recovered: the request then fails as it would.
    async fn recoverIfDropped(borrow mut this) -> Result<void, MsSqlError> {
        if (this.descriptor != 0 || !this.recovery.possible() || await this.isAlive()) {
            return Ok();
        }
        var request = Vector<u8>.create();
        this.recovery.recoveryRequest(
            this.databaseName.view(),
            this.languageName.view(),
            this.session.collation,
            mut request,
        )?;
        let config = replace(mut this.recovery.config, null) ?? { return Ok(); };
        let tries = config.connectRetryCount() as u32;
        var failure = MsSqlError.Closed;
        var attempt: u32 = 0;
        while (attempt < tries) {
            match (await MsSqlConnection.connectWith(borrow config, request.view(), true)) {
                Ok(fresh) => {
                    var c = fresh;
                    // The new session goes on where the old one was: the request, its settings, its state.
                    c.output = replace(mut this.output, Vector<u8>.create());
                    c.resetPending = this.resetPending;
                    c.commandMillis = this.commandMillis;
                    var state = replace(mut this.recovery, noRecovery());
                    for (st in c.recovery.states.view()) {
                        state.setState(st.id, st.data.view(), st.recoverable)?;
                    }
                    state.acknowledged = c.recovery.acknowledged;
                    state.config = Some(config);
                    c.recovery = state;
                    c.recoveredCount = this.recoveredCount + 1;
                    *this = c;
                    return Ok();
                }
                Err(e) => { failure = e; }
            }
            attempt += 1;
            if (attempt < tries) {
                ioResult(await Timer.sleep(config.connectRetryInterval()))?;
            }
        }
        this.recovery.config = Some(config);
        return Err(failure);
    }

    /// The certificate the server presented, as DER, put in `out`: what `ServerCertificate` or
    /// `MsSqlConfig.setServerCertificate` would pin. False when the session is not encrypted (after a login-only
    /// encryption, `Encrypt=false`).
    public fn serverCertificate(borrow this, out: borrow mut Vector<u8>) -> Result<bool, MsSqlError> {
        out.clear();
        match (borrow this.tls) {
            Some(engine) => { return tlsResult(engine.peerCertificate(out)); }
            null => { return Ok(false); }
        }
    }

    /// Whether the server still holds this idle connection: one the server, a failover or a middlebox closed has
    /// its end of stream (or a reset) waiting, which a read finds at once. It never waits; it is false while an
    /// operation is under way or after one failed.
    public async fn isAlive(borrow mut this) -> bool {
        if (!this.isReady() || this.inStart != this.inEnd) {
            return false;
        }
        var one = [0u8; 1];
        let probe = await Async.timeout(0, AsyncError.TimedOut, async () => await this.tcp.read(mut one[..]));
        // Nothing to read is a live connection; an end, an error, or bytes nobody asked for are not.
        return probe is Err(AsyncError.TimedOut);
    }

    /// Whether the connection can take another operation: not broken, and no streamed query unfinished.
    public fn isReady(borrow this) -> bool => !this.busy && this.stream == S_IDLE;

    /// Whether the session is encrypted after the login.
    public fn isEncrypted(borrow this) -> bool => this.tls != null;

    /// The server's version.
    public fn serverVersion(borrow this) -> MsServerVersion => this.version;

    /// The current database, as the server last said (after `USE`, too).
    public fn database(borrow this) -> StringView => this.databaseName.view();

    /// The server's id for this session (`@@SPID`).
    public fn processId(borrow this) -> u16 => this.spid;

    /// The packet size the server agreed on.
    public fn negotiatedPacketSize(borrow this) -> usize => this.packetSize;

    /// Sets the command timeout for this connection's operations, in milliseconds (0: none).
    public fn setCommandTimeout(borrow mut this, millis: u64) {
        this.commandMillis = millis;
    }

    /// Asks the server to reset the session (sp_reset_connection: temporary tables, SET options, the isolation
    /// level) as part of the next request, as a pool does between leases.
    public fn resetSession(borrow mut this) {
        this.resetPending = true;
    }

    /// Tries to make a `Broken` connection usable again after an operation was cancelled from outside (an
    /// `Async.timeout` of the caller's, a lost race): sends an attention and skips the rest of the response. Fails
    /// if the cancellation struck while a request was being written, or the server does not answer in time.
    public async fn recover(borrow mut this) -> Result<void, MsSqlError> {
        if (!this.busy) {
            return Ok();
        }
        if (this.sending || this.fatal || !this.loginAcked) {
            return Err(MsSqlError.Broken);
        }
        return await this.recoverWithin();
    }

    /// Ends the session: TLS's close_notify, then the socket closes when the connection is dropped. Dropping it
    /// without `close` is safe too.
    public async fn close(borrow mut this) -> Result<void, MsSqlError> {
        this.busy = true;
        var pending = false;
        match (borrow mut this.tls) {
            Some(engine) => {
                match (engine.shutdown()) {
                    Ok() => {}
                    Err(_) => {}
                }
                this.cipher.clear();
                match (engine.takeAllOutput(mut this.cipher)) {
                    Ok() => { pending = this.cipher.length > 0; }
                    Err(_) => {}
                }
            }
            null => {}
        }
        if (pending) {
            match (await this.tcp.write(this.cipher.view())) {
                Ok() => {}
                Err(_) => {}
            }
        }
        match (this.tcp.shutdownWrite()) {
            Ok() => {}
            Err(_) => {}
        }
        return Ok();
    }
}

/// A RETURNVALUE token's body (2.2.7.18) at `at`, added to `outputs` as a column named after the parameter
/// (without its `@`).
fn readReturnValue(
    data: Slice<u8>,
    at: usize,
    outputs: borrow mut MsSqlRows,
    need: borrow mut usize,
) -> Result<usize?, MsSqlError> {
    // ParamOrdinal (2), ParamName (B_VARCHAR), Status (1), UserType (4), Flags (2), TYPE_INFO, value.
    if (at + 3 > data.length) {
        return Ok(null);
    }
    let units = data[at + 2] as usize;
    let nameEnd = at + 3 + units * 2;
    if (nameEnd + 7 > data.length) {
        return Ok(null);
    }
    var name = Vector<u8>.create();
    allocated(Utf16.decodeBytes(data[at + 3..nameEnd], mut name))?;
    let bare = if (name.length > 0 && name[0] == '@') 1usize else 0usize;
    var column = blankColumn();
    column.flags = data.readLE<u16>(nameEnd + 5);
    let typeEnd = readTypeInfo(data, nameEnd + 7, mut column, false)? ?? { return Ok(null); };
    var valueNeed: usize = 0;
    match (outputs.addOutput(name[bare..], column, data, typeEnd, mut valueNeed)?) {
        Some(end) => { return Ok(Some(end)); }
        null => {
            if (valueNeed > 0) {
                need = typeEnd - at + valueNeed;
            }
            return Ok(null);
        }
    }
}

fn tlsEngine(config: borrow TlsConfig, host: StringView) -> Result<TlsEngine, MsSqlError> {
    match (TlsEngine.client(config, host)) {
        Ok(e) => { return Ok(e); }
        Err(e) => { return Err(MsSqlError.Tls(e)); }
    }
}

fn buildPreLoginOrFail(encryption: u8, instance: StringView, out: borrow mut Vector<u8>) -> Result<void, MsSqlError> =>
    allocated(buildPreLogin(encryption, instance, out));

fn tlsResult<T>(outcome: Result<T, TlsError>) -> Result<T, MsSqlError> {
    match (outcome) {
        Ok(v) => { return Ok(v); }
        Err(e) => { return Err(MsSqlError.Tls(e)); }
    }
}

fn ioResult<T>(outcome: Result<T, AsyncError>) -> Result<T, MsSqlError> {
    match (outcome) {
        Ok(v) => { return Ok(v); }
        Err(e) => { return Err(MsSqlError.Io(e)); }
    }
}

/// `addresses` in the order `preference` asks for: one family first, each in the resolver's order.
fn preferred(
    addresses: Slice<SocketAddress>,
    preference: MsAddressPreference,
) -> Result<Vector<SocketAddress>, MsSqlError> {
    var ordered = Vector<SocketAddress>.create();
    let v4First = match (preference) {
        MsAddressPreference.PlatformDefault => {
            for (a in addresses) {
                allocated(ordered.push(a))?;
            }
            return Ok(ordered);
        }
        MsAddressPreference.IPv4First => true,
        MsAddressPreference.IPv6First => false,
    };
    for (pass in 0..2) {
        let wantV4 = if (pass == 0) v4First else !v4First;
        for (a in addresses) {
            if ((a is SocketAddress.V4(_, _)) == wantV4) {
                allocated(ordered.push(a))?;
            }
        }
    }
    return Ok(ordered);
}

/// Login errors that pass: an Azure SQL database starting, resuming, failing over or short of resources
/// (SqlClient's list, and 4060 for a database not yet open).
fn isTransient(number: u32) -> bool =>
    number == 4060 || number == 4221 || number == 10928 || number == 10929 || number == 40197 || number == 40501 ||
        number == 40613 || number == 42108 || number == 42109 || number == 49918 || number == 49919 || number == 49920;

/// The first of `addresses` that accepts a connection, tried in order.
async fn connectFirst(addresses: Slice<SocketAddress>) -> Result<AsyncTcpStream, MsSqlError> {
    var failure = MsSqlError.Closed;
    for (address in addresses) {
        match (await AsyncTcpStream.connectTo(address)) {
            Ok(tcp) => { return Ok(tcp); }
            Err(e) => { failure = MsSqlError.Io(e); }
        }
    }
    return Err(failure);
}

/// How a parallel connect's children end: one connected (which stops the rest), or no memory for a child.
enum MsRace {
    Won,
    OutOfMemory,
}

/// The first of `addresses` to accept a connection, all tried at once (MultiSubnetFailover). The first to connect
/// sends its stream and ends the scope with `Won`, which cancels the others; a failure sends its error.
async fn connectAny(addresses: Slice<SocketAddress>) -> Result<AsyncTcpStream, MsSqlError> {
    let results = match (Channel<Result<AsyncTcpStream, AsyncError>>.create(addresses.length)) {
        Ok(c) => c,
        Err(_) => { return Err(MsSqlError.OutOfMemory); }
    };
    let outcome = await Async.scope(MsRace.OutOfMemory, (s) => {
        for (address in addresses) {
            let sink = borrow results;
            s.spawn(async move () => {
                match (await AsyncTcpStream.connectTo(address)) {
                    Ok(tcp) => {
                        let _ = sink.trySend(Ok(tcp));
                        return Err(MsRace.Won);
                    }
                    Err(e) => {
                        let _ = sink.trySend(Err(e));
                        return Ok();
                    }
                }
            });
        }
    });
    if (outcome is Err(MsRace.OutOfMemory)) {
        return Err(MsSqlError.OutOfMemory);
    }
    var failure = MsSqlError.Closed;
    loop {
        match (results.tryRecv()) {
            Some(Ok(tcp)) => { return Ok(tcp); }
            Some(Err(e)) => { failure = MsSqlError.Io(e); }
            null => { return Err(failure); }
        }
    }
}

/// The length of `bytes`' longest prefix that does not end inside a UTF-8 sequence.
fn utf8Boundary(bytes: Slice<u8>) -> usize {
    let n = bytes.length;
    var back: usize = 1;
    while (back <= 3 && back <= n) {
        let b = bytes[n - back];
        if ((b & 0xC0) != 0x80) {
            // A lead byte (or ASCII): whole if its sequence fits in what follows it.
            let size: usize =
                if (b < 0x80) 1usize else (if (b >= 0xF0) 4usize else (if (b >= 0xE0) 3usize else 2usize));
            return if (size <= back) n else n - back;
        }
        back += 1;
    }
    return n;
}

/// With a pinned certificate (`pin` not empty), that the server presented exactly it.
fn checkPin(engine: borrow TlsEngine, pin: Slice<u8>) -> Result<void, MsSqlError> {
    if (pin.length == 0) {
        return Ok();
    }
    var presented = Vector<u8>.create();
    if (!tlsResult(engine.peerCertificate(mut presented))? || presented.view() != pin) {
        return Err(MsSqlError.Tls(TlsError.Certificate));
    }
    return Ok();
}

/// What a login sends beyond the configuration: a pinned certificate to check, feature extensions, and whether it
/// recovers a session.
struct MsLoginPlan<region r> {
    pin: Slice<r, u8>;
    features: Slice<r, u8>;
    reconnecting: bool;
}
