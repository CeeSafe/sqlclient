// The login: PRELOGIN (MS-TDS 2.2.6.5) agrees on encryption, LOGIN7 (2.2.6.4) authenticates, NTLM (MS-NLMP) when
// the login uses a Windows account.

const PRELOGIN_VERSION: u8 = 0x00;
const PRELOGIN_ENCRYPTION: u8 = 0x01;
const PRELOGIN_INSTOPT: u8 = 0x02;
const PRELOGIN_THREADID: u8 = 0x03;
const PRELOGIN_MARS: u8 = 0x04;
const PRELOGIN_TERMINATOR: u8 = 0xFF;

const ENCRYPT_OFF: u8 = 0x00;
const ENCRYPT_ON: u8 = 0x01;
const ENCRYPT_NOT_SUP: u8 = 0x02;
const ENCRYPT_REQ: u8 = 0x03;

/// TDS 7.4, SQL Server 2012 and later.
const TDS_VERSION_7_4: u32 = 0x74000004;

/// A PRELOGIN request offering `encryption`, for `instance` (empty: any).
fn buildPreLogin(encryption: u8, instance: StringView, out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    out.clear();
    // Five options of five bytes each, then the terminator; the data follows.
    let header: usize = 5 * 5 + 1;
    let version = [0x10u8, 0x00, 0x00, 0x00, 0x00, 0x00]; // the client's version, informational
    let instanceLength = instance.length + 1;
    let lengths = [6usize, 1, instanceLength, 4, 1];
    let tokens = [PRELOGIN_VERSION, PRELOGIN_ENCRYPTION, PRELOGIN_INSTOPT, PRELOGIN_THREADID, PRELOGIN_MARS];
    var offset = header;
    for (k in 0..5usize) {
        out.push(tokens[k])?;
        out.pushBE(truncate<u16>(offset))?;
        out.pushBE(truncate<u16>(lengths[k]))?;
        offset += lengths[k];
    }
    out.push(PRELOGIN_TERMINATOR)?;
    out.extend(version[..])?;
    out.push(encryption)?;
    out.extend(instance.bytes())?;
    out.push(0)?;
    out.pushBE(0u32)?; // thread id
    out.push(0)?;      // MARS off
    return Ok();
}

/// What a PRELOGIN response says.
struct PreLoginAnswer {
    encryption: u8;
    /// The server's major version (16 for SQL Server 2022).
    major: u8;
    minor: u8;
    build: u16;
}

fn parsePreLogin(payload: Slice<u8>) -> Result<PreLoginAnswer, MsSqlError> {
    var answer = PreLoginAnswer { encryption: ENCRYPT_NOT_SUP, major: 0, minor: 0, build: 0 };
    var at: usize = 0;
    loop {
        if (at >= payload.length) {
            return Err(MsSqlError.Protocol);
        }
        let token = payload[at];
        if (token == PRELOGIN_TERMINATOR) {
            return Ok(answer);
        }
        if (at + 5 > payload.length) {
            return Err(MsSqlError.Protocol);
        }
        let offset = payload.readBE<u16>(at + 1) as usize;
        let length = payload.readBE<u16>(at + 3) as usize;
        at += 5;
        if (offset + length > payload.length) {
            return Err(MsSqlError.Protocol);
        }
        if (token == PRELOGIN_ENCRYPTION && length >= 1) {
            answer.encryption = payload[offset];
        } else if (token == PRELOGIN_VERSION && length >= 4) {
            answer.major = payload[offset];
            answer.minor = payload[offset + 1];
            answer.build = payload.readBE<u16>(offset + 2);
        }
    }
}

/// What goes into a LOGIN7 message.
struct LoginFields<region r> {
    hostName: StringView<r>;
    userName: StringView<r>;
    password: StringView<r>;
    appName: StringView<r>;
    serverName: StringView<r>;
    language: StringView<r>;
    database: StringView<r>;
    /// An NTLM NEGOTIATE message, for a Windows login; empty for a SQL login.
    sspi: Slice<r, u8>;
    packetSize: u32;
    readOnlyIntent: bool;
    /// The feature extensions (MS-TDS 2.2.6.4 FeatureExt), each an id, a four-byte length and data, ended by 0xFF;
    /// empty for none.
    features: Slice<r, u8>;
}

/// A LOGIN7 message (MS-TDS 2.2.6.4).
fn buildLogin7(fields: borrow LoginFields, out: borrow mut Vector<u8>) -> Result<void, MsSqlError> {
    out.clear();
    let fixed: usize = 94;
    allocated(out.resize(fixed, 0))?;
    let w = out.viewMut();
    w.writeLE(4, TDS_VERSION_7_4);
    w.writeLE(8, fields.packetSize);
    w.writeLE(12, 0x07000000u32); // client program version, informational
    w.writeLE(16, 0u32);          // client process id
    w.writeLE(20, 0u32);          // connection id
    // OptionFlags1: USE_DB_ON (warn on a database change) and INIT_DB_FATAL (fail if the database cannot be
    // opened), SET_LANG_ON. OptionFlags2: INIT_LANG_FATAL and ODBC (ANSI defaults on: ANSI_NULLS, QUOTED_IDENTIFIER,
    // …, which indexed views and filtered indexes need), and integrated security for NTLM.
    w[24] = 0xE0;
    w[25] = if (fields.sspi.length > 0) 0x83u8 else 0x03u8;
    w[26] = if (fields.readOnlyIntent) 0x20u8 else 0x00u8;
    w[27] = if (fields.features.length > 0) 0x10u8 else 0u8; // OptionFlags3: fExtension
    w.writeLE(28, 0i32);                                     // client time zone
    w.writeLE(32, 0x0409u32);                                // client LCID
    // The variable part, in the offset table's order.
    var at = fixed;
    at = putLoginText(out, 36, fields.hostName, at, false)?;
    at = putLoginText(out, 40, fields.userName, at, false)?;
    at = putLoginText(out, 44, fields.password, at, true)?;
    at = putLoginText(out, 48, fields.appName, at, false)?;
    at = putLoginText(out, 52, fields.serverName, at, false)?;
    // The extension: a four-byte offset of the FeatureExt block, which goes at the very end.
    let extensionAt = out.length;
    if (fields.features.length > 0) {
        allocated(out.resize(out.length + 4, 0))?;
        let e = out.viewMut();
        e.writeLE(56, truncate<u16>(extensionAt));
        e.writeLE(58, 4u16);
        at = out.length;
    } else {
        at = putLoginText(out, 56, "", at, false)?;
    }
    at = putLoginText(out, 60, "sqlclient", at, false)?;
    at = putLoginText(out, 64, fields.language, at, false)?;
    at = putLoginText(out, 68, fields.database, at, false)?;
    // ClientID (a MAC address) stays zero.
    if (fields.sspi.length > 0xFFFF) {
        return Err(MsSqlError.TooLarge);
    }
    let sspiAt = out.length;
    allocated(out.extend(fields.sspi))?;
    if (fields.features.length > 0) {
        let featuresAt = out.length;
        allocated(out.extend(fields.features))?;
        out.viewMut().writeLE(extensionAt, truncate<u32>(featuresAt));
    }
    let total = out.length;
    if (total > 0xFFFF) {
        return Err(MsSqlError.TooLarge);
    }
    let v = out.viewMut();
    v.writeLE(78, truncate<u16>(sspiAt));
    v.writeLE(80, truncate<u16>(fields.sspi.length));
    v.writeLE(82, truncate<u16>(total)); // no database file to attach
    v.writeLE(84, 0u16);
    v.writeLE(86, truncate<u16>(total)); // no password change
    v.writeLE(88, 0u16);
    v.writeLE(90, 0u32);
    v.writeLE(0, truncate<u32>(total));
    return Ok();
}

/// Appends `text` in UTF-16 and records its offset and length (in characters) at `slot`; the end.
fn putLoginText(
    out: borrow mut Vector<u8>,
    slot: usize,
    text: StringView,
    at: usize,
    obfuscate: bool,
) -> Result<usize, MsSqlError> {
    let start = out.length;
    allocated(Utf16.encode(text, out))?;
    let units = (out.length - start) / 2;
    if (units > 128 && slot != 44) {
        return Err(MsSqlError.TooLarge);
    }
    if (obfuscate) {
        // The password is not encrypted, only scrambled: each byte's nibbles swapped, then XOR 0xA5. Without TLS
        // anyone on the path can read it.
        let end = out.length;
        let w = out.viewMut();
        for (i in start..end) {
            let b = w[i];
            w[i] = ((b << 4) | (b >> 4)) ^ 0xA5;
        }
    }
    let end = out.length;
    let w = out.viewMut();
    w.writeLE(slot, truncate<u16>(start));
    w.writeLE(slot + 2, truncate<u16>(units));
    return Ok(end);
}

// ---- NTLM (MS-NLMP), NTLMv2 only ----

const NTLM_SIGNATURE: [u8; 8] = [0x4Eu8, 0x54, 0x4C, 0x4D, 0x53, 0x53, 0x50, 0x00];
/// UNICODE, REQUEST_TARGET, NTLM, ALWAYS_SIGN, EXTENDED_SESSIONSECURITY, TARGET_INFO, 128, 56.
const NTLM_FLAGS: u32 = 0xA0888205;

/// An NTLM NEGOTIATE message.
fn ntlmNegotiate(out: borrow mut Vector<u8>) -> Result<void, AllocError> {
    out.clear();
    out.extend(NTLM_SIGNATURE[..])?;
    out.pushLE(1u32)?;
    out.pushLE(NTLM_FLAGS)?;
    out.resize(32, 0)?; // no domain or workstation supplied
    return Ok();
}

/// The parts of an NTLM CHALLENGE message an NTLMv2 answer needs.
struct NtlmChallenge {
    flags: u32;
    challenge: [u8; 8];
    infoAt: usize;
    infoLength: usize;
    /// The server's time (FILETIME) from its target information, or 0.
    timestamp: u64;
}

fn parseNtlmChallenge(data: Slice<u8>) -> Result<NtlmChallenge, MsSqlError> {
    if (data.length < 48 || !data[0..8].startsWith(NTLM_SIGNATURE[..]) || data.readLE<u32>(8) != 2) {
        return Err(MsSqlError.Protocol);
    }
    var c = NtlmChallenge {
        flags: data.readLE<u32>(20),
        challenge: [0u8; 8],
        infoAt: 0,
        infoLength: 0,
        timestamp: 0,
    };
    c.challenge[..].copyFrom(data[24..32]);
    let infoLength = data.readLE<u16>(40) as usize;
    let infoAt = data.readLE<u32>(44) as usize;
    if (infoLength > 0 && infoAt + infoLength <= data.length) {
        c.infoAt = infoAt;
        c.infoLength = infoLength;
        // AV pairs: id (2), length (2), value; MsvAvTimestamp is 7, MsvAvEOL 0.
        var at = infoAt;
        let end = infoAt + infoLength;
        while (at + 4 <= end) {
            let id = data.readLE<u16>(at);
            let length = data.readLE<u16>(at + 2) as usize;
            if (id == 0 || at + 4 + length > end) {
                break;
            }
            if (id == 7 && length == 8) {
                c.timestamp = data.readLE<u64>(at + 4);
            }
            at += 4 + length;
        }
    }
    return Ok(c);
}

/// The NTLMv2 responses for `challenge`: the NT response (NTProofStr then the blob) and the LMv2 response.
fn ntlmV2Responses(
    user: StringView,
    domain: StringView,
    password: StringView,
    challenge: borrow NtlmChallenge,
    targetInfo: Slice<u8>,
    clientChallenge: Slice<u8>,
    timestamp: u64,
    nt: borrow mut Vector<u8>,
    lm: borrow mut Vector<u8>,
) -> Result<void, AllocError> {
    var secret = Vector<u8>.create();
    Utf16.encode(password, mut secret)?;
    let ntHash = md4(secret.view());
    // NTOWFv2 = HMAC_MD5(NT hash, UPPER(user) + domain), in UTF-16.
    var identity = Vector<u8>.create();
    var upper = Vector<u8>.create();
    for (c in user.bytes()) {
        upper.push(if (c >= 'a' && c <= 'z') c - 32 else c)?;
    }
    Utf16.encode(StringView.fromUtf8(upper.view())!, mut identity)?;
    Utf16.encode(domain, mut identity)?;
    let key = hmacMd5(ntHash[..], identity.view());
    // The blob: 0x0101, reserved, the time, the client's challenge, reserved, the target information, reserved.
    var blob = Vector<u8>.create();
    blob.extend([0x01u8, 0x01, 0x00, 0x00][..])?;
    blob.pushLE(0u32)?;
    blob.pushLE(timestamp)?;
    blob.extend(clientChallenge)?;
    blob.pushLE(0u32)?;
    blob.extend(targetInfo)?;
    blob.pushLE(0u32)?;
    var message = Vector<u8>.create();
    message.extend(challenge.challenge[..])?;
    message.extend(blob.view())?;
    let proof = hmacMd5(key[..], message.view());
    nt.clear();
    nt.extend(proof[..])?;
    nt.extend(blob.view())?;
    message.clear();
    message.extend(challenge.challenge[..])?;
    message.extend(clientChallenge)?;
    let lmProof = hmacMd5(key[..], message.view());
    lm.clear();
    lm.extend(lmProof[..])?;
    lm.extend(clientChallenge)?;
    return Ok();
}

/// An NTLM AUTHENTICATE message answering `challengeBytes`.
fn ntlmAuthenticate(
    challengeBytes: Slice<u8>,
    user: StringView,
    domain: StringView,
    password: StringView,
    workstation: StringView,
    out: borrow mut Vector<u8>,
) -> Result<void, MsSqlError> {
    let challenge = parseNtlmChallenge(challengeBytes)?;
    var clientChallenge = [0u8; 8];
    match (Random.fill(mut clientChallenge[..])) {
        Ok() => {}
        Err(_) => { return Err(MsSqlError.UnsupportedAuthentication); }
    }
    let serverTime = challenge.timestamp;
    let timestamp = if (serverTime != 0) serverTime
        else truncate<u64>(Clock.unixMillis() + 11644473600000) * 10000;
    let info = challengeBytes[challenge.infoAt..challenge.infoAt + challenge.infoLength];
    var nt = Vector<u8>.create();
    var lm = Vector<u8>.create();
    allocated(
        ntlmV2Responses(user, domain, password, challenge, info, clientChallenge[..], timestamp, mut nt, mut lm),
    )?;
    if (serverTime != 0) {
        // With the server's time in the target information, the LM response is 24 zero bytes (MS-NLMP 3.1.5.1.2).
        lm.clear();
        allocated(lm.resize(24, 0))?;
    }
    var domainBytes = Vector<u8>.create();
    var userBytes = Vector<u8>.create();
    var hostBytes = Vector<u8>.create();
    allocated(Utf16.encode(domain, mut domainBytes))?;
    allocated(Utf16.encode(user, mut userBytes))?;
    allocated(Utf16.encode(workstation, mut hostBytes))?;
    out.clear();
    let header: usize = 64;
    allocated(out.resize(header, 0))?;
    out.viewMut()[0..8].copyFrom(NTLM_SIGNATURE[..]);
    out.viewMut().writeLE(8, 3u32);
    // The payload in the order the fields' descriptors come: LM, NT, domain, user, workstation, session key.
    putSecurityBuffer(out, 12, lm.view())?;
    putSecurityBuffer(out, 20, nt.view())?;
    putSecurityBuffer(out, 28, domainBytes.view())?;
    putSecurityBuffer(out, 36, userBytes.view())?;
    putSecurityBuffer(out, 44, hostBytes.view())?;
    putSecurityBuffer(out, 52, [])?;
    out.viewMut().writeLE(60, NTLM_FLAGS & challenge.flags | 0x00000001);
    return Ok();
}

fn putSecurityBuffer(out: borrow mut Vector<u8>, slot: usize, bytes: Slice<u8>) -> Result<void, MsSqlError> {
    if (bytes.length > 0xFFFF) {
        return Err(MsSqlError.TooLarge);
    }
    let at = out.length;
    allocated(out.extend(bytes))?;
    let w = out.viewMut();
    w.writeLE(slot, truncate<u16>(bytes.length));
    w.writeLE(slot + 2, truncate<u16>(bytes.length));
    w.writeLE(slot + 4, truncate<u32>(at));
    return Ok();
}

/// HMAC-MD5 (RFC 2104) under a key of at most 64 bytes, as NTLM uses it.
fn hmacMd5(key: Slice<u8>, message: Slice<u8>) -> [u8; 16] {
    var block = [0u8; 64];
    if (key.length > 64) {
        let digest = Md5.of(key);
        block[0..16].copyFrom(digest[..]);
    } else {
        block[0..key.length].copyFrom(key);
    }
    var inner = [0u8; 64];
    var outer = [0u8; 64];
    for (i in 0..64usize) {
        inner[i] = block[i] ^ 0x36;
        outer[i] = block[i] ^ 0x5C;
    }
    var h = Md5.create();
    h.update(inner[..]);
    h.update(message);
    let first = h.finish();
    var o = Md5.create();
    o.update(outer[..]);
    o.update(first[..]);
    return o.finish();
}

/// MD4 (RFC 1320), for the NT hash of a password.
fn md4(input: Slice<u8>) -> [u8; 16] {
    var state = [0x67452301u32, 0xEFCDAB89, 0x98BADCFE, 0x10325476];
    var block = [0u8; 64];
    let blocks = (input.length + 8) / 64 + 1;
    var x = [0u32; 16];
    for (k in 0..blocks) {
        // The k-th 64-byte block of the padded message: the input, 0x80, zeros, the bit length.
        for (i in 0..64usize) {
            let at = k * 64 + i;
            block[i] = if (at < input.length) input[at] else (if (at == input.length) 0x80u8 else 0u8);
        }
        if (k == blocks - 1) {
            block[..].writeLE(56, (input.length as u64) * 8);
        }
        for (j in 0..16usize) {
            x[j] = block[..].readLE<u32>(j * 4);
        }
        var a = state[0];
        var b = state[1];
        var c = state[2];
        var d = state[3];
        let r1 = [3u32, 7, 11, 19];
        for (i in 0..16usize) {
            let f = (b & c) | ((b ^ 0xFFFFFFFF) & d);
            let t = a.wrappingAdd(f).wrappingAdd(x[i]).rotateLeft(r1[i % 4]);
            a = d;
            d = c;
            c = b;
            b = t;
        }
        let r2 = [3u32, 5, 9, 13];
        for (i in 0..16usize) {
            let g = (b & c) | (b & d) | (c & d);
            let index = (i % 4) * 4 + i / 4;
            let t = a.wrappingAdd(g).wrappingAdd(x[index]).wrappingAdd(0x5A827999).rotateLeft(r2[i % 4]);
            a = d;
            d = c;
            c = b;
            b = t;
        }
        let r3 = [3u32, 9, 11, 15];
        let order = [0usize, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15];
        for (i in 0..16usize) {
            let h = b ^ c ^ d;
            let t = a.wrappingAdd(h).wrappingAdd(x[order[i]]).wrappingAdd(0x6ED9EBA1).rotateLeft(r3[i % 4]);
            a = d;
            d = c;
            c = b;
            b = t;
        }
        state[0] = state[0].wrappingAdd(a);
        state[1] = state[1].wrappingAdd(b);
        state[2] = state[2].wrappingAdd(c);
        state[3] = state[3].wrappingAdd(d);
    }
    var digest = [0u8; 16];
    for (i in 0..4usize) {
        digest[..].writeLE(i * 4, state[i]);
    }
    return digest;
}
