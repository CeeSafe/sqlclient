fn main() {
    var s = String.create();
    Console.writeLine(s.appendChar(0x48)!);        // H
    s.appendChar(0xE9)!;                           // é
    s.appendChar(0x4E16)!;                         // 世
    s.appendChar(0x1F600)!;                        // 😀
    Console.writeLine(s.appendChar(0xD800)!);      // false: a surrogate
    Console.writeLine(s.appendChar(0x110000)!);    // false
    let good = [0x21u8, 0xC3, 0xA9];
    let bad = [0xC3u8];
    Console.writeLine(s.appendUtf8(good[..])!);    // true
    Console.writeLine(s.appendUtf8(bad[..])!);     // false
    Console.writeLine(s.view());
    var v = Vector<u8>.create();
    v.appendChar(0x263A)!;
    v.appendUtf8("ok".bytes())!;
    Console.writeLine(StringView.fromUtf8(v.view())!);
}
