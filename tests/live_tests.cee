        Some(c) => c,
        null => { return Ok(); }
    };
    return report(Async.run(timeouts(config)));
}

async fn pooled(pool: borrow MsSqlPool) -> Outcome {
    let none = MsSqlParams.create();
    var spid: i64 = 0;
    {
        var lease = match (await pool.acquire()) {
            Ok(l) => l,
            Err(e) => { return connectFailed(e); }
        };
        match (await lease.connection().batch("CREATE TABLE #leftover (id int); SET LOCK_TIMEOUT 1234")) {
            Ok(_) => {}
            Err(e) => { return failed(e, lease.connection()); }
        }
        match (await lease.connection().query("SELECT @@SPID", none)) {
            Ok(r) => { spid = r.int64(0, 0)!; }
            Err(e) => { return failed(e, lease.connection()); }
        }
    }
    var again = match (await pool.acquire()) {
        Ok(l) => l,
        Err(e) => { return connectFailed(e); }
    };
    match (await again.connection().query("SELECT @@SPID, OBJECT_ID('tempdb..#leftover'), @@LOCK_TIMEOUT", none)) {
        Ok(r) => {
            if (r.int64(0, 0) != Some(spid)) {
                return wrong("the same session again");
            }
            if (!r.isNull(0, 1) || r.int64(0, 2) != Some(-1i64)) {
                return wrong("the session reset between leases");
            }
        }
        Err(e) => { return failed(e, again.connection()); }
    }
    return passed();
}

