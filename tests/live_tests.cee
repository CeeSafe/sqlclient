// ── Backups (opt-in: they write a file on the server) ────────────────────────────────────────────────────────

async fn backupAndRestore(config: borrow MsSqlConfig, path: StringView) -> Outcome {
    var db = match (await MsSqlConnection.connect(config)) {
        Ok(c) => c,
        Err(e) => { return connectFailed(e); }
    };
    let none = MsSqlParams.create();
    let name = match (await db.query("SELECT DB_NAME()", none)) {
        Ok(r) => r,
        Err(e) => { return failed(e, db); }
    };
    var database = String.create();
    database.append(name.text(0, 0)!)!;
    match (await db.backupDatabase(database.view(), path, false, true)) {
        Ok() => {}
        Err(e) => { return failed(e, db); }
    }
    // Restoring needs the database to itself: move this session away first.
    match (await db.batch("USE master")) {
        Ok(_) => {}
        Err(e) => { return failed(e, db); }
    }
    match (await db.restoreDatabase(database.view(), path)) {
        Ok() => {}
        Err(e) => { return failed(e, db); }
    }
    return passed();
}

/// MSSQL_TEST_BACKUP_PATH: a file path on the server's disk, e.g. /var/opt/mssql/data/sqlclient_test.bak. The test
/// backs the test database up there and restores it over itself.
@test
fn backupsAndRestores() -> Result<void, TestFailure> {
    let config = match (testConfig()) {
        Some(c) => c,
        null => { return Ok(); }
    };
    let path = match (Environment.variable("MSSQL_TEST_BACKUP_PATH")) {
        Some(p) => p,
        null => { return Ok(); }
    };
    return report(Async.run(backupAndRestore(config, path)));
}
