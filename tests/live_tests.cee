async fn timeouts(config: borrow MsSqlConfig) -> Outcome {
    var db = match (await MsSqlConnection.connect(config)) {
        Ok(c) => c,
        Err(e) => { return connectFailed(e); }
    };
    let none = MsSqlParams.create();
    db.setCommandTimeout(300);
    let started = Timer.now();
    match (await db.execute("WAITFOR DELAY '00:00:05'", none)) {
        Err(MsSqlError.TimedOut) => {}
        Ok(_) => { return wrong("WAITFOR should time out"); }
        Err(e) => { return failed(e, db); }
    }
    if (Timer.now() - started > 4000) {
        return wrong("the timeout ended the wait");
    }
    if (!db.isReady()) {
        return wrong("usable after a timeout (the attention was answered)");
    }
    db.setCommandTimeout(30000);
    match (await db.query("SELECT 'after timeout'", none)) {
        Ok(r) => {
            if (r.text(0, 0) != Some("after timeout")) {
                return wrong("the answer after a timeout");
            }
        }
        Err(e) => { return failed(e, db); }
    }
    return passed();
}

